{"artifact_schema_version":"rag-retrieval-candidate-v1","bm25_score_scaled":2150341506,"candidate_id":"fc9736e262bb74b2cf9574b816c21accd3012767d5118c47db205f09d80dc094","candidate_rank":130,"canonical_name":"YAML::NodeEvents::Emit","chunk_id":"785a57623009680613d6e5f62fb36d52d8c04b78bc5a343514795f4a5798d963","content":"void NodeEvents::Emit(const detail::node& node, EventHandler& handler,\n                      AliasManager& am) const {\n  anchor_t anchor = NullAnchor;\n  if (IsAliased(node)) {\n    anchor = am.LookupAnchor(node);\n    if (anchor) {\n      handler.OnAlias(Mark(), anchor);\n      return;\n    }\n\n    am.RegisterReference(node);\n    anchor = am.LookupAnchor(node);\n  }\n\n  switch (node.type()) {\n    case NodeType::Undefined:\n      break;\n    case NodeType::Null:\n      handler.OnNull(node.mark(), anchor);\n      break;\n    case NodeType::Scalar:\n      handler.OnScalar(node.mark(), node.tag(), anchor, node.scalar());\n      break;\n    case NodeType::Sequence:\n      handler.OnSequenceStart(node.mark(), node.tag(), anchor, node.style());\n      for (auto element : node)\n        Emit(*element, handler, am);\n      handler.OnSequenceEnd();\n      break;\n    case NodeType::Map:\n      handler.OnMapStart(node.mark(), node.tag(), anchor, node.style());\n      for (auto element : node) {\n        Emit(*element.first, handler, am);\n        Emit(*element.second, handler, am);\n      }\n      handler.OnMapEnd();\n      break;\n  }\n}","content_sha256":"0d740dac00965ee98e118b248f054b14da0ce63c2f77ef47e6f58aa448f27b6c","content_token_count":276,"context_block_sha256":"a8ab67abbfbda444b291cf5003bcaf5f6f1a0a387a8298cf0bb7f3d700e61705","direct_relation":false,"directory_distance":4,"eligible":true,"eligible_rank":130,"end_byte":2449,"end_line":92,"exact_match_rank":99,"exclusion_reasons":[],"kind":"method_definition","original_case_match":true,"overlap_evidence":[],"parent_symbol":"YAML::NodeEvents","path":"src/nodeevents.cpp","repository_commit":"3eb39d5