{"model":"devstral-small-2:24b-instruct-2512-q4_K_M","created_at":"2026-08-11T17:15:16.3142732Z","response":"{\n  \"units\": [\n    {\n      \"content\": \"#pragma once\\n\\n#include \\\"log.h\\\"\\n#include \\\"util.h\\\"\\n\\n#include \u003calgorithm\u003e\\n#include \u003ccassert\u003e\\n#include \u003cchrono\u003e\\n#include \u003ccompare\u003e\\n#include \u003cdeque\u003e\\n#include \u003cfunctional\u003e\\n#include \u003coptional\u003e\\n#include \u003cstdexcept\u003e\\n#include \u003cunordered_map\u003e\\n\\nnamespace ws {\\n\\ntemplate \u003ctypename Key\u003e\\nclass HeapTimer {\\npublic:\\n    using Clock = std::chrono::steady_clock;\\n    using TimeOutCallback = std::function\u003cvoid(const Key\u0026)\u003e;\\n\\n    explicit HeapTimer(log::Logger::Ptr logger = log::RootLogger()) noexcept\\n        : logger_(std::move(logger)) {}\\n\\n    void Push(const Key\u0026 key, Clock::duration expiration, TimeOutCallback callback) noexcept {\\n        assert(!Contain(key));\\n        const auto now = Clock::now();\\n        nodes_.emplace_back(Node{key, now + expiration, std::move(callback)});\\n        const auto idx = nodes_.size() - 1u;\\n        key_to_idx_[key] = idx;\\n        ShiftUp(idx);\\n    }\\n\\n    void Push(const Key\u0026 key, Clock::time_point expiration, TimeOutCallback callback) noexcept {\\n        assert(!Contain(key));\\n        nodes_.emplace_back(Node{key, expiration, std::move(callback)});\\n        const auto idx = nodes_.size() - 1u;\\n        key_to_idx_[key] = idx;\\n        ShiftUp(idx);\\n    }\\n\\n    void Adjust(const Key\u0026 key, Clock::duration expiration) {\\n        const auto now = Clock::now();\\n        Adjust(key, now + expiration);\\n    }\\n\\n    void Adjust(const Key\u0026 key, Clock::time_point expiration) {\\n        const auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) {\\n            throw std::out_of_range(\\\"Key not found in HeapTimer\\\");\\n        }\\n        const auto idx = it-\u003esecond;\\n        auto\u0026 node = nodes_[idx];\\n        const auto old_expiration = node.expiration;\\n        node.expiration = expiration;\\n        if (expiration \u003c old_expiration) {\\n            ShiftUp(idx);\\n        } else if (expiration \u003e old_expiration) {\\n            ShiftDown(idx);\\n        }\\n    }\\n\\n    void Tick() noexcept {\\n        while (!Empty()) {\\n            const auto\u0026 node = nodes_.front();\\n            if (!node.Expired()) break;\\n            try {\\n                node.callback(node.key);\\n            } catch (...) {\\n                logger_-\u003eerror(\\\"Exception in timeout callback for key: {}\\\", node.key);\\n            }\\n            Pop();\\n        }\\n    }\\n\\n    bool Remove(const Key\u0026 key) noexcept {\\n        const auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) return false;\\n        const auto idx = it-\u003esecond;\\n        RemoveByIndex(idx);\\n        return true;\\n    }\\n\\n    Key Pop() noexcept {\\n        assert(!Empty());\\n        const auto key = nodes_.front().key;\\n        RemoveByIndex(0u);\\n        return key;\\n    }\\n\\n    void Clear() noexcept {\\n        nodes_.clear();\\n        key_to_idx_.clear();\\n    }\\n\\n    bool Contain(const Key\u0026 key) const noexcept {\\n        return key_to_idx_.find(key) != key_to_idx_.end();\\n    }\\n\\n    bool Empty() const noexcept {\\n        return nodes_.empty();\\n    }\\n\\n    std::size_t Size() const noexcept {\\n        return nodes_.size();\\n    }\\n\\n    Clock::duration ToNextTick() noexcept {\\n        if (Empty()) return Clock::duration::max();\\n        const auto now = Clock::now();\\n        const auto next = nodes_.front().expiration;\\n        return std::max(Clock::duration::zero(), next - now);\\n    }\\n\\nprivate:\\n    struct Node {\\n        Key key;\\n        Clock::time_point expiration;\\n        TimeOutCallback callback;\\n\\n        bool Expired() const noexcept {\\n            return Clock::now() \u003e= expiration;\\n        }\\n\\n        void Swap(Node\u0026 other) noexcept {\\n            std::swap(key, other.key);\\n            std::swap(expiration, other.expiration);\\n            std::swap(callback, other.callback);\\n        }\\n\\n        friend std::weak_ordering operator\u003c=\u003e(const Node\u0026 lhs, const Node\u0026 rhs) noexcept {\\n            return lhs.expiration \u003c=\u003e rhs.expiration;\\n        }\\n    };\\n\\n    void ShiftUp(std::size_t idx) noexcept {\\n        while (idx \u003e 0u) {\\n            const auto parent = (idx - 1u) / 2u;\\n            if (!(nodes_[idx] \u003c nodes_[parent])) break;\\n            nodes_[idx].Swap(nodes_[parent]);\\n            key_to_idx_[nodes_[idx].key] = idx;\\n            key_to_idx_[nodes_[parent].key] = parent;\\n            idx = parent;\\n        }\\n    }\\n\\n    void ShiftDown(std::size_t idx) noexcept {\\n        const auto last = nodes_.size() - 1u;\\n        while (true) {\\n            std::size_t child = 2u * idx + 1u;\\n            if (child \u003e last) break;\\n            if (child + 1u \u003c= last \u0026\u0026 nodes_[child] \u003e nodes_[child + 1u]) {\\n                ++child;\\n            }\\n            if (!(nodes_[child] \u003c nodes_[idx])) break;\\n            nodes_[idx].Swap(nodes_[child]);\\n            key_to_idx_[nodes_[idx].key] = idx;\\n            key_to_idx_[nodes_[child].key] = child;\\n            idx = child;\\n        }\\n    }\\n\\n    void RemoveByIndex(std::size_t idx) noexcept {\\n        if (idx == nodes_.size() - 1u) {\\n            nodes_.pop_back();\\n            key_to_idx_.erase(nodes_[idx].key);\\n            return;\\n        }\\n        nodes_[idx].Swap(nodes_.back());\\n        key_to_idx_[nodes_[idx].key] = idx;\\n        key_to_idx_[nodes_.back().key] = nodes_.size() - 1u;\\n        nodes_.pop_back();\\n        if (idx \u003c nodes_.size()) {\\n            ShiftDown(idx);\\n        }\\n    }\\n\\n    log::Logger::Ptr logger_;\\n    std::unordered_map\u003cKey, std::size_t\u003e key_to_idx_;\\n    std::deque\u003cNode\u003e nodes_;\\n};\\n\\n} // namespace ws\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[17,74799,1067,1670,12579,17962,17397,7360,5862,71490,5342,8317,8745,1320,12086,4156,107536,37825,130811,67470,31689,29188,38287,4187,40257,2713,2768,23909,10146,1160,21637,1749,38798,19528,1155,22949,32661,12579,17962,4187,111533,19212,2650,7360,5862,5013,61861,1320,51566,2650,36283,38798,19528,1155,8979,2439,32171,1146,9590,4187,130811,67470,31689,29188,5120,36512,13908,2305,1749,4979,32171,1146,9590,2650,22949,61296,11780,47960,68231,38287,4187,65286,5013,61861,1320,5165,38798,19528,1155,8979,8709,1749,2612,1187,4338,7568,1164,24308,1749,31551,15627,6564,1749,76421,2768,42607,15627,6059,1749,48394,98074,8390,1749,11674,76420,40154,33934,7068,1167,1749,31551,15627,6667,127144,17858,76421,2768,31551,15627,13908,40723,4187,7360,5862,2305,1749,6667,20759,2439,11449,38287,4187,7059,18961,5013,11544,7886,25544,1320,25075,38234,61453,13655,38234,38798,19528,1155,8979,8709,1749,4310,10482,61453,31603,1749,110252,2768,4310,1749,10280,1749,4125,1749,24308,128108,1749,4463,121411,2439,110490,1749,4463,121411,2439,23153,19212,78828,1749,22409,83355,127144,17858,76421,2768,29045,43367,4187,7360,5862,5013,61861,1320,57008,2713,2768,31551,15627,85254,1749,128108,38287,1749,61453,29045,43367,2439,3087,42687,38287,4187,7059,18961,5013,11544,7886,25544,1320,25075,38234,105629,38234,8709,4310,5115,10280,3410,38798,19528,1155,8979,5296,18807,24129,2701,36379,13568,61716,8440,1749,5165,1047,14218,106046,12600,2439,22675,13667,1186,12579,17962,20837,6589,47960,68231,4187,65286,5013,11544,7886,25544,1320,130811,67470,31689,29188,2650,32498,19702,24308,1749,17624,25109,23761,1749,5020,11610,1144,11054,1134,55550,1749,125950,11054,1134,55550,1749,91492,7568,1164,1749,4630,3549,1749,77408,67629,17624,25109,4187,8525