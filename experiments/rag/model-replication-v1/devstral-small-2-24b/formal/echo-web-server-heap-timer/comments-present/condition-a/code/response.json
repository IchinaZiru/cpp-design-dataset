..) {\\n                    if (logger_) logger_-\u003eerror(\\\"Timer callback exception\\\");\\n                }\\n                RemoveByIndex(0);\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    bool Remove(const Key\u0026 key) noexcept {\\n        const auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) return false;\\n        RemoveByIndex(it-\u003esecond);\\n        return true;\\n    }\\n\\n    void Invoke(const Key\u0026 key) {\\n        const auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) throw std::out_of_range(\\\"Key not found\\\");\\n        const auto idx = it-\u003esecond;\\n        nodes_[idx].callback(nodes_[idx].key);\\n        RemoveByIndex(idx);\\n    }\\n\\n    Key Pop() noexcept {\\n        assert(!nodes_.empty());\\n        return RemoveByIndex(0);\\n    }\\n\\n    void Clear() noexcept {\\n        key_to_idx_.clear();\\n        nodes_.clear();\\n    }\\n\\n    bool Contain(const Key\u0026 key) const noexcept {\\n        return key_to_idx_.count(key) \u003e 0;\\n    }\\n\\n    bool Empty() const noexcept {\\n        return nodes_.empty();\\n    }\\n\\n    std::size_t Size() const noexcept {\\n        return nodes_.size();\\n    }\\n\\n    Clock::duration ToNextTick() noexcept {\\n        Tick();\\n        if (nodes_.empty()) return Clock::duration::zero();\\n        const auto now = Clock::now();\\n        const auto next = nodes_.front().expiration;\\n        return next \u003e now ? next - now : Clock::duration::zero();\\n    }\\n\\nprivate:\\n    struct Node {\\n        Key key;\\n        Clock::time_point expiration;\\n        TimeOutCallback callback;\\n\\n        bool Expired() const noexcept {\\n            return Clock::now() \u003e= expiration;\\n        }\\n\\n        void Swap(Node\u0026 other) noexcept {\\n            std::swap(key, other.key);\\n            std::swap(expiration, other.expiration);\\n            std::swap(callback, other.callback);\\n        }\\n\\n        friend auto operator\u003c=\u003e(const Node\u0026 lhs, const Node\u0026 rhs) noexcept {\\n            return lhs.expiration \u003c=\u003e rhs.expiration;\\n        }\\n    };\\n\\n    log::Logger::Ptr logger_;\\n    std::unordered_map\u003cKey, std::size_t\u003e key_to_idx_;\\n    std::deque\u003cNode\u003e nodes_;\\n\\n    void ShiftUp(std::size_t idx) noexcept {\\n        while (const auto parent = Parent(idx)) {\\n            if (!(nodes_[*parent] \u003c nodes_[idx])) break;\\n            Swap(*parent, idx);\\n            idx = *parent;\\n        }\\n    }\\n\\n    void ShiftDown(std::size_t idx) noexcept {\\n        while (const auto child = SmallChild(idx)) {\\n            if (!(nodes_[idx] \u003c nodes_[*child])) break;\\n            Swap(idx, *child);\\n            idx = *child;\\n        }\\n    }\\n\\n    void Swap(std::size_t idx1, std::size_t idx2) noexcept {\\n        std::swap(nodes_[idx1], nodes_[idx2]);\\n        key_to_idx_[nodes_[idx1].key] = idx1;\\n        key_to_idx_[nodes_[idx2].key] = idx2;\\n    }\\n\\n    bool ValidIndex(std::size_t idx) const noexcept {\\n        return idx \u003c nodes_.size();\\n    }\\n\\n    std::optional\u003cstd::size_t\u003e Parent(std::size_t idx) const noexcept {\\n        if (idx == 0) return std::nullopt;\\n        return (idx - 1) / 2;\\n    }\\n\\n    std::optional\u003cstd::size_t\u003e SmallChild(std::size_t idx) const noexcept {\\n        const auto left = 2 * idx + 1;\\n        const auto right = 2 * idx + 2;\\n        if (!ValidIndex(left)) return std::nullopt;\\n        if (!ValidIndex(right)) return left;\\n        return nodes_[left] \u003c nodes_[right] ? left : right;\\n    }\\n\\n    void Adjust(const Key\u0026 key, Clock::time_point expiration, std::optional\u003cTimeOutCallback\u003e callback) {\\n        const auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) throw std::out_of_range(\\\"Key not found\\\");\\n        const auto idx = it-\u003esecond;\\n        if (callback) nodes_[idx].callback = *callback;\\n        nodes_[idx].expiration = expiration;\\n        ShiftUp(idx);\\n        ShiftDown(idx);\\n    }\\n\\n    Key RemoveByIndex(std::size_t idx) noexcept {\\n        assert(ValidIndex(idx));\\n        const auto key = nodes_[idx].key;\\n        if (idx != nodes_.size() - 1) {\\n            Swap(idx, nodes_.size() - 1);\\n            ShiftUp(idx);\\n            ShiftDown(idx);\\n        }\\n        key_to_idx_.erase(key);\\n        nodes_.pop_back();\\n        return key;\\n    }\\n};\\n\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[17,74799,1067,1670,12579,17962,17397,7360,5862,71490,5342,8317,8745,1320,12086,4156,107536,37825,130811,67470,31689,29188,38287,4187,40257,2713,2768,23909,10146,1160,21637,1749,38798,19528,1155,22949,32661,12579,17962,4187,111533,19212,2650,7360,5862,5013,61861,1320,51566,2650,36283,38798,19528,1155,8979,2439,32171,1146,9590,4187,130811,67470,31689,29188,5120,36512,13908,2305,1749,4979,32171,1146,9590,2650,22949,61296,11780,47960,68231,38287,4187,65286,5013,61861,1320,5165,38798,19528,1155,8979,8709,1749,2612,1187,4338,7568,1164,24308,1749,31551,15627,6564,1749,76421,2768,42607,15627,6059,1749,48394,98074,8390,1749,11674,76420,40154,33934,7068,1167,1749,31551,15627,6667,127144,17858,76421,2768,31551,15627,13908,40723,4187,7360,5862,2305,1749,6667,20759,2439,11449,38287,4187,7059,18961,5013,11544,7886,25544,1320,25075,38234,61453,13655,38234,38798,19528,1155,8979,8709,1749,4310,10482,61453,31603,1749,110252,2768,4310,1749,10280,1749,4125,1749,24308,128108,1749,4463,121411,2439,110490,1749,4463,121411,2439,23153,19212,78828,1749,22409,83355,127144,17858,76421,2768,29045,43367,4187,7360,5862,5013,61861,1320,57008,2713,2768,31551,15627,85254,1749,128108,38287,1749,61453,29045,43367,2439,3087,42687,38287,4187,7059,18961,5013,11544,7886,25544,1320,25075,38234,105629,38234,8709,4310,5115,10280,3410,38798