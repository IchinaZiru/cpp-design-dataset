view prefix = \\\"\\\") noexcept;\\n\\n    template \u003ctypename T, typename... Args\u003e\\n    class Singleton {\\n    public:\\n        template \u003cArgs... args\u003e\\n        static T\u0026 Instance() noexcept;\\n    };\\n\\n    template \u003ctypename T, typename... Args\u003e\\n    class SingletonPtr {\\n    public:\\n        template \u003cArgs... args\u003e\\n        static std::shared_ptr\u003cT\u003e Instance() noexcept;\\n    };\\n\\n    template \u003ctypename T, typename Cleaner = std::function\u003cvoid(T)\u003e\u003e\\n    requires std::is_invocable_v\u003cCleaner, T\u003e\\n    class RAII {\\n    public:\\n        explicit RAII(T obj, Cleaner cleaner) noexcept;\\n        ~RAII() noexcept;\\n        const T\u0026 Object() const noexcept;\\n    private:\\n        T obj_;\\n        Cleaner cleaner_;\\n    };\\n\\n    class MappedReadOnlyFile {\\n    public:\\n        MappedReadOnlyFile() noexcept;\\n        ~MappedReadOnlyFile() noexcept;\\n        std::byte* Map(std::string path);\\n        void Unmap() noexcept;\\n        std::size_t Size() const noexcept;\\n        std::byte* Data() const noexcept;\\n        std::string_view Path() const noexcept;\\n    private:\\n        void Check();\\n        std::string path_;\\n        struct stat stat_ {};\\n        std::byte* data_ {nullptr};\\n    };\\n\\n    template \u003ctypename T, typename U, typename Ret = T\u003e\\n    concept Addable = requires(T t, U u) {\\n        { t + u } -\u003e std::convertible_to\u003cRet\u003e;\\n    };\\n}\\n\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    },\n    {\n      \"content\": \"#include \\\"util.h\\\"\\n#include \u003cfmt/format.h\u003e\\n#include \u003cyaml-cpp/yaml.h\u003e\\n#include \u003csys/stat.h\u003e\\n#include \u003cunistd.h\u003e\\n#include \u003cfcntl.h\u003e\\n#include \u003csys/mman.h\u003e\\n#include \u003ccstring\u003e\\n#include \u003csystem_error\u003e\\n\\nnamespace ws {\\n    std::string StringToLower(std::string str) noexcept {\\n        for (auto\u0026 c : str) {\\n            c = static_cast\u003cchar\u003e(std::tolower(static_cast\u003cunsigned char\u003e(c)));\\n        }\\n        return str;\\n    }\\n\\n    std::string StringToUpper(std::string str) noexcept {\\n        for (auto\u0026 c : str) {\\n            c = static_cast\u003cchar\u003e(std::toupper(static_cast\u003cunsigned char\u003e(c)));\\n        }\\n        return str;\\n    }\\n\\n    std::string ReplaceAllSubstring(std::string_view str, std::string_view from,\\n                                    std::string_view to) noexcept {\\n        if (from.empty()) return std::string(str);\\n        std::string result;\\n        size_t start_pos = 0;\\n        size_t found_pos;\\n        while ((found_pos = str.find(from, start_pos)) != std::string::npos) {\\n            result.append(str.substr(start_pos, found_pos - start_pos));\\n            result.append(to);\\n            start_pos = found_pos + from.length();\\n        }\\n        result.append(str.substr(start_pos));\\n        return result;\\n    }\\n\\n    std::vector\u003cstd::string\u003e SplitString(const std::string\u0026 str,\\n                                         const std::regex\u0026 pattern) noexcept {\\n        std::vector\u003cstd::string\u003e result;\\n        std::sregex_token_iterator it(str.begin(), str.end(), pattern, -1);\\n        std::sregex_token_iterator end;\\n        for (; it != end; ++it) {\\n            result.emplace_back(*it);\\n        }\\n        return result;\\n    }\\n\\n    std::vector\u003cstd::string\u003e SplitStringToLines(const std::string\u0026 str) noexcept {\\n        std::vector\u003cstd::string\u003e result;\\n        size_t start = 0;\\n        size_t end = str.find('\\\\n');\\n        while (end != std::string::npos) {\\n            result.push_back(str.substr(start, end - start));\\n            start = end + 1;\\n            end = str.find('\\\\n', start);\\n        }\\n        if (start \u003c str.length()) {\\n            result.push_back(str.substr(start));\\n        }\\n        return result;\\n    }\\n\\n    YAML::Node LoadYamlString(\\n        std::string_view str,\\n        std::initializer_list\u003cstd::string_view\u003e required_fields) {\\n        try {\\n            YAML::Node node = YAML::Load(str);\\n            for (const auto\u0026 field : required_fields) {\\n                if (!node[field.data()]) {\\n                    throw std::runtime_error(fmt::format(\\\"Required field '{}' not found\\\", field));\\n                }\\n                ThrowIfYamlFieldIsNotScalar(node, field);\\n            }\\n            return node;\\n        } catch (const YAML::Exception\u0026 e) {\\n            throw std::runtime_error(fmt::format(\\\"Failed to parse YAML: {}\\\", e.what()));\\n        }\\n    }\\n\\n    void ThrowIfYamlFieldIsNotScalar(const YAML::Node\u0026 node,\\n                                     std::string_view field) {\\n        if (!node[field.data()].IsScalar()) {\\n            throw std::runtime_error(fmt::format(\\\"Field '{}' is not a scalar\\\", field));\\n        }\\n    }\\n\\n    constexpr bool IsValidFileDescriptor(FileDescriptor fd) noexcept {\\n        return fd \u003e= 0;\\n    }\\n\\n    void SetFileDescriptorAsNonblocking(FileDescriptor fd) {\\n        int flags = fcntl(fd, F_GETFL, 0);\\n        if (flags == -1) {\\n            ThrowLastSystemError();\\n        }\\n        if (fcntl(fd, F_SETFL, flags | O_NONBLOCK) == -1) {\\n            ThrowLastSystemError();\\n        }\\n    }\\n\\n    [[noreturn]] void ThrowLastSystemError() {\\n        throw std::system_error(errno, std::generic_category());\\n    }\\n\\n    std::uint32_t CurrentThreadId() noexcept {\\n        return static_cast\u003cstd::uint32_t\u003e(pthread_self());\\n    }\\n\\n    void Backtrace(std::vector\u003cstd::string\u003e\u0026 stack, std::size_t size,\\n                   std::size_t skip) noexcept {\\n        void* frames[100];\\n        int num_frames = backtrace(frames, static_cast\u003cint\u003e(std::min(size, static_cast\u003csize_t\u003e(100))));\\n        char** symbols = backtrace_symbols(frames, num_frames);\\n        for (int i = skip; i \u003c num_frames; ++i) {\\n            stack.emplace_back(symbols[i]);\\n        }\\n        free(symbols);\\n    }\\n\\n    std::string Backtrace(std::size_t size, std::size_t skip,\\n                          std::string_view prefix) noexcept {\\n        std::vector\u003cstd::string\u003e stack;\\n        Backtrace(stack, size, skip);\\n        std::string result;\\n        for (const auto\u0026 frame : stack) {\\n            if (!result.empty()) result += \\\"\\\\n\\\";\\n            result += prefix;\\n            result += frame;\\n        }\\n        return result;\\n    }\\n\\n    template \u003ctypename T, typename... Args\u003e\\n    template \u003cArgs... args\u003e\\n    T\u0026 Singleton\u003cT, Args...\u003e::Instance() noexcept {\\n        static T instance(std::forward\u003cArgs\u003e(args)...);\\n        return instance;\\n    }\\n\\n    template \u003ctypename T, typename... Args\u003e\\n    template \u003cArgs... args\u003e\\n    std::shared_ptr\u003cT\u003e SingletonPtr\u003cT, Args...\u003e::Instance() noexcept {\\n        static std::shared_ptr\u003cT\u003e instance = std::make_shared\u003cT\u003e(std::forward\u003cArgs\u003e(args)...);\\n        return instance;\\n    }\\n\\n    template \u003ctypename T, typename Cleaner\u003e\\n    requires std::is_invocable_v\u003cCleaner, T\u003e\\n    RAII\u003cT, Cleaner\u003e::RAII(T obj, Cleaner cleaner) noexcept : obj_(std::move(obj)), cleaner_(cleaner) {}\\n\\n    template \u003ctypename T, typename Cleaner\u003e\\n    requires std::is_invocable_v\u003cCleaner, T\u003e\\n    RAII\u003cT, Cleaner\u003e::~RAII() noexcept {\\n        if (cleaner_) cleaner_(obj_);\\n    }\\n\\n    template \u003ctypename T, typename Cleaner\u003e\\n    requires std::is_invocable_v\u003cCleaner, T\u003e\\n    const T\u0026 RAII\u003cT, Cleaner\u003e::Object() const noexcept {\\n        return obj_;\\n    }\\n\\n    MappedReadOnlyFile::MappedReadOnlyFile() noexcept = default;\\n\\n    MappedReadOnlyFile::~MappedReadOnlyFile() noexcept {\\n        Unmap();\\n    }\\n\\n    std::byte* MappedReadOnlyFile::Map(std::string path) {\\n        path_ = std::move(path);\\n        if (stat(path_.c_str(), \u0026stat_) != 0) {\\n            ThrowLastSystemError();\\n        }\\n        int fd = open(path_.c_str(), O_RDONLY);\\n        if (fd == -1) {\\n            ThrowLastSystemError();\\n        }\\n        data_ = static_cast\u003cstd::byte*\u003e(mmap(nullptr, stat_.st_size, PROT_READ, MAP_PRIVATE, fd, 0));\\n        close(fd);\\n        if (data_ == MAP_FAILED) {\\n            ThrowLastSystemError();\\n        }\\n        Check();\\n        return data_;\\n    }\\n\\n    void MappedReadOnlyFile::Unmap() noexcept {\\n        if (data_ != nullptr \u0026\u0026 data_ != MAP_FAILED) {\\n            munmap(data_, stat_.st_size);\\n            data_ = nullptr;\\n        }\\n    }\\n\\n    std::size_t MappedReadOnlyFile::Size() const noexcept {\\n        return stat_.st_size;\\n    }\\n\\n    std::byte* MappedReadOnlyFile::Data() const noexcept {\\n        return data_;\\n    }\\n\\n    std::string_view MappedReadOnlyFile::Path() const noexcept {\\n        return path_;\\n    }\\n\\n    void MappedReadOnlyFile::Check() {\\n        if (data_ == nullptr || data_ == MAP_FAILED) {\\n            throw std::runtime_error(\\\"Failed to map file\\\");\\n        }\\n    }\\n}\\n\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[17,74799,1067,1670,12579,17962,17397,7360,5862,71490,5342,8317,8745,1320,12086,4156,107536,37825,130811,67470,31689,29188,38287,4187,40257,2713,2768,23909,10146,1160,21637,1749,38798,19528,1155,22949,32661,12579,17962,4187,111533,19212,2650,7360,5862,5013,61861,1320,51566,2650,36283,38798,19528,1155,8979,2439,32171,1146,9590,4187,130