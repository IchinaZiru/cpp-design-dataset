ing(std::string_view str, std::string_view from, std::string_view to) {\\n    if (from.empty()) return std::string(str);\\n    std::string result;\\n    size_t start_pos = 0;\\n    size_t found_pos;\\n    while ((found_pos = str.find(from, start_pos)) != std::string::npos) {\\n        result.append(str.substr(start_pos, found_pos - start_pos));\\n        result.append(to);\\n        start_pos = found_pos + from.length();\\n    }\\n    result.append(str.substr(start_pos));\\n    return result;\\n}\\n\\nstd::vector\u003cstd::string\u003e SplitString(const std::string\u0026 str, const std::regex\u0026 pattern) {\\n    std::vector\u003cstd::string\u003e result;\\n    std::sregex_token_iterator it(str.begin(), str.end(), pattern, -1);\\n    std::sregex_token_iterator end;\\n    for (; it != end; ++it) {\\n        result.emplace_back(*it);\\n    }\\n    return result;\\n}\\n\\nstd::vector\u003cstd::string\u003e SplitStringToLines(const std::string\u0026 str) {\\n    std::vector\u003cstd::string\u003e result;\\n    std::istringstream iss(str);\\n    std::string line;\\n    while (std::getline(iss, line)) {\\n        result.push_back(line);\\n    }\\n    return result;\\n}\\n\\nYAML::Node LoadYamlString(std::string_view str, std::initializer_list\u003cstd::string_view\u003e required_fields) {\\n    YAML::Node node = YAML::Load(str);\\n    if (!node.IsMap()) throw std::runtime_error(\\\"Invalid YAML: root must be a map\\\");\\n    for (auto field : required_fields) {\\n        if (!node[field.data()]) throw std::runtime_error(fmt::format(\\\"Missing required field: {}\\\", field));\\n    }\\n    return node;\\n}\\n\\nvoid ThrowIfYamlFieldIsNotScalar(const YAML::Node\u0026 node, std::string_view field) {\\n    if (!node[field.data()].IsScalar()) throw std::runtime_error(fmt::format(\\\"Field '{}' is not a scalar\\\", field));\\n}\\n\\nbool IsValidFileDescriptor(FileDescriptor fd) {\\n    return fd != invalid_file_descriptor \u0026\u0026 fcntl(fd, F_GETFD) != -1 || errno != EBADF;\\n}\\n\\nvoid SetFileDescriptorAsNonblocking(FileDescriptor fd) {\\n    int flags = fcntl(fd, F_GETFL);\\n    if (flags == -1) ThrowLastSystemError();\\n    if (fcntl(fd, F_SETFL, flags | O_NONBLOCK) == -1) ThrowLastSystemError();\\n}\\n\\nvoid ThrowLastSystemError() {\\n    throw std::system_error(errno, std::generic_category());\\n}\\n\\nstd::uint32_t CurrentThreadId() {\\n    return static_cast\u003cstd::uint32_t\u003e(pthread_self());\\n}\\n\\nvoid Backtrace(std::vector\u003cstd::string\u003e\u0026 stack, std::size_t size, std::size_t skip) {\\n    void* buffer[1024];\\n    int frames = backtrace(buffer, static_cast\u003cint\u003e(std::min(size, sizeof(buffer)/sizeof(void*))));\\n    char** symbols = backtrace_symbols(buffer, frames);\\n    for (int i = skip; i \u003c frames; ++i) {\\n        stack.emplace_back(symbols[i]);\\n    }\\n    free(symbols);\\n}\\n\\nstd::string Backtrace(std::size_t size, std::size_t skip, std::string_view prefix) {\\n    std::vector\u003cstd::string\u003e stack;\\n    Backtrace(stack, size, skip);\\n    return fmt::format(\\\"{}{}\\\", prefix, fmt::join(stack, \\\"\\\\n\\\"));\\n}\\n\\nstd::byte* MappedReadOnlyFile::Map() {\\n    Unmap();\\n    path_ = path_; // Ensure path is set\\n    if (stat(path_.c_str(), \u0026stat_) == -1) ThrowLastSystemError();\\n    FileDescriptor fd = open(path_.c_str(), O_RDONLY);\\n    if (fd == invalid_file_descriptor) ThrowLastSystemError();\\n    SetFileDescriptorAsNonblocking(fd);\\n    data_ = static_cast\u003cstd::byte*\u003e(mmap(nullptr, stat_.st_size, PROT_READ, MAP_PRIVATE, fd, 0));\\n    close(fd);\\n    if (data_ == MAP_FAILED) ThrowLastSystemError();\\n    return data_;\\n}\\n\\nvoid MappedReadOnlyFile::Unmap() {\\n    if (data_) {\\n        munmap(data_, stat_.st_size);\\n        data_ = nullptr;\\n    }\\n}\\n\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[17,74799,1067,1670,12579,17962,17397,7360,5862,71490,534