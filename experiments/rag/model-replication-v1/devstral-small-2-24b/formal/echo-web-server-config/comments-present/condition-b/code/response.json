td::runtime_error(\\\"Expected sequence\\\");\\n        }\\n        return node.as\u003cstd::list\u003cT\u003e\u003e();\\n    }\\n};\\n\\n// ... (other specializations for vector, set, unordered_set, map, unordered_map)\\n\\nclass VarBase {\\npublic:\\n    using Ptr = std::shared_ptr\u003cVarBase\u003e;\\n    \\n    VarBase(std::string_view name, std::string_view description = \\\"\\\") noexcept;\\n    virtual ~VarBase() noexcept = default;\\n    \\n    std::string_view Name() const noexcept;\\n    std::string_view Description() const noexcept;\\n    \\n    virtual std::string ToString() const noexcept = 0;\\n    virtual void FromString(std::string_view str) = 0;\\n    \\nprivate:\\n    std::string name_;\\n    std::string description_;\\n};\\n\\ntemplate\u003ctypename T, typename FromStr = VarConverter\u003cstd::string, T\u003e, typename ToStr = VarConverter\u003cT, std::string\u003e\u003e\\nclass Var : public VarBase {\\npublic:\\n    using Ptr = std::shared_ptr\u003cVar\u003e;\\n    \\n    Var(std::string_view name, const T\u0026 default_val, std::string_view description = \\\"\\\") noexcept;\\n    \\n    std::string ToString() const noexcept override;\\n    void FromString(std::string_view str) override;\\n    \\n    T GetValue() const noexcept;\\n    void SetValue(const T\u0026 val) noexcept;\\n    \\n    std::string_view TypeName() const noexcept;\\n    \\n    void RemoveListener(std::uint64_t key) noexcept;\\n    std::uint64_t AddListener(std::function\u003cvoid(const T\u0026)\u003e listener) noexcept;\\n    void ClearListeners() noexcept;\\n    \\nprivate:\\n    mutable std::shared_mutex mtx_;\\n    T val_;\\n    std::unordered_map\u003cstd::uint64_t, std::function\u003cvoid(const T\u0026)\u003e\u003e listeners_;\\n};\\n\\nclass Config {\\npublic:\\n    using Ptr = std::shared_ptr\u003cConfig\u003e;\\n    \\n    Config(std::string_view name) noexcept;\\n    \\n    std::string_view Name() const noexcept;\\n    \\n    template\u003ctypename T\u003e\\n    typename Var\u003cT\u003e::Ptr Lookup(std::string_view name, const T\u0026 default_val, std::string_view description = \\\"\\\") {\\n        std::lock_guard lock(mtx_);\\n        auto it = vars_.find(std::string(name));\\n        if (it == vars_.end()) {\\n            auto var = std::make_shared\u003cVar\u003cT\u003e\u003e(name, default_val, description);\\n            vars_[std::string(name)] = var;\\n            return var;\\n        }\\n        return std::static_pointer_cast\u003cVar\u003cT\u003e\u003e(it-\u003esecond);\\n    }\\n    \\n    template\u003ctypename T\u003e\\n    typename Var\u003cT\u003e::Ptr Lookup(std::string_view name) const {\\n        std::lock_guard lock(mtx_);\\n        auto it = vars_.find(std::string(name));\\n        if (it == vars_.end()) {\\n            throw std::runtime_error(\\\"Variable not found\\\");\\n        }\\n        return std::static_pointer_cast\u003cVar\u003cT\u003e\u003e(it-\u003esecond);\\n    }\\n    \\n    VarBase::Ptr LookupBase(std::string_view name) const noexcept;\\n    \\n    void LoadYaml(const YAML::Node\u0026 root);\\n    \\n    void Visit(std::function\u003cvoid(VarBase::Ptr)\u003e visitor) const noexcept;\\n    \\nprivate:\\n    mutable std::shared_mutex mtx_;\\n    std::string name_;\\n    std::unordered_map\u003cstd::string, VarBase::Ptr\u003e vars_;\\n};\\n\\nConfig::Ptr RootConfig() noexcept;\\n}\\n\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    },\n    {\n      \"content\": \"#include \\\"config.h\\\"\\n#include \u003cyaml-cpp/yaml.h\u003e\\n\\nnamespace ws::cfg {\\n\\nVarBase::VarBase(std::string_view name, std::string_view description) noexcept : name_(name), description_(description) {}\\n\\nstd::string_view VarBase::Name() const noexcept {\\n    return name_;\\n}\\n\\nstd::string_view VarBase::Description() const noexcept {\\n    return description_;\\n}\\n\\nConfig::Config(std::string_view name) noexcept : name_(name) {}\\n\\nstd::string_view Config::Name() const noexcept {\\n    return name_;\\n}\\n\\nVarBase::Ptr Config::LookupBase(std::string_view name) const noexcept {\\n    std::lock_guard lock(mtx_);\\n    auto it = vars_.find(std::string(name));\\n    if (it == vars_.end()) {\\n        return nullptr;\\n    }\\n    return it-\u003esecond;\\n}\\n\\nvoid Config::LoadYaml(const YAML::Node\u0026 root) {\\n    auto members = ExtractMembers(root);\\n    for (const auto\u0026 [key, node] : members) {\\n        if (!key.empty()) {\\n            auto var = LookupBase(key);\\n            if (var) {\\n                try {\\n                    var-\u003eFromString(node.Scalar());\\n                } catch (...) {\\n                    // Exception handling as per design spec\\n                }\\n            }\\n        }\\n    }\\n}\\n\\nvoid Config::Visit(std::function\u003cvoid(VarBase::Ptr)\u003e visitor) const noexcept {\\n    std::lock_guard lock(mtx_);\\n    for (const auto\u0026 [name, var] : vars_) {\\n        visitor(var);\\n    }\\n}\\n\\nConfig::Ptr RootConfig() noexcept {\\n    static Config::Ptr instance = std::make_shared\u003cConfig\u003e(\\\"root\\\");\\n    return instance;\\n}\\n\\nstd::list\u003cstd::pair\u003cstd::string, YAML::Node\u003e\u003e ExtractMembers(const YAML::Node\u0026 node, const std::string\u0026 prefix) {\\n    std::list\u003cstd::pair\u003cstd::string, YAML::Node\u003e\u003e members;\\n    if (node.IsMap()) {\\n        for (const auto\u0026 [key, value] : node) {\\n            std::string new_key = prefix.empty() ? key.as\u003cstd::string\u003e() : prefix + \\\".\\\" + key.as\u003cstd::string\u003e();\\n            members.emplace_back(new_key, value);\\n            auto sub_members = ExtractMembers(value, new_key);\\n            members.insert(members.end(), sub_members.begin(), sub_members.end());\\n        }\\n    }\\n    return members;\\n}\\n}\\n\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[17,74799,1067,1670,12579,17962,17397,7360,