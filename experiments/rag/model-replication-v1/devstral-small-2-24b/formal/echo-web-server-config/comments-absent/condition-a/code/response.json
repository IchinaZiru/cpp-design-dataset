arConverter\u003cstd::string, std::string\u003e {\\n    static std::string Convert(const std::string\u0026 str) {\\n        return str;\\n    }\\n};\\n\\n// Specializations for collection types\\ntemplate\u003ctypename T\u003e\\nstruct VarConverter\u003cstd::string, std::vector\u003cT\u003e\u003e {\\n    static std::vector\u003cT\u003e Convert(const std::string\u0026 yamlStr) {\\n        try {\\n            YAML::Node node = YAML::Load(yamlStr);\\n            if (!node.IsSequence()) {\\n                throw std::invalid_argument(\\\"Expected sequence for vector conversion\\\");\\n            }\\n            std::vector\u003cT\u003e result;\\n            for (const auto\u0026 item : node) {\\n                result.push_back(VarConverter\u003cstd::string, T\u003e::Convert(item.as\u003cstd::string\u003e()));\\n            }\\n            return result;\\n        } catch (const std::exception\u0026 e) {\\n            throw std::invalid_argument(fmt::format(\\\"Vector conversion error: {}\\\", e.what()));\\n        }\\n    }\\n};\\n\\ntemplate\u003ctypename T\u003e\\nstruct VarConverter\u003cstd::vector\u003cT\u003e, std::string\u003e {\\n    static std::string Convert(const std::vector\u003cT\u003e\u0026 vec) {\\n        YAML::Node node;\\n        for (const auto\u0026 item : vec) {\\n            node.push_back(VarConverter\u003cT, std::string\u003e::Convert(item));\\n        }\\n        return YAML::Dump(node);\\n    }\\n};\\n\\n// Similar specializations would be added for list, set, unordered_set, map, and unordered_map types\\n\\n// VarBase abstract class\\nclass VarBase {\\npublic:\\n    virtual ~VarBase() = default;\\n    \\n    virtual std::string Name() const = 0;\\n    virtual std::string Description() const = 0;\\n    virtual std::string ToString() const = 0;\\n    virtual void FromString(const std::string\u0026 str) = 0;\\n};\\n\\n// Var template class\\ntemplate\u003ctypename T, typename FromStr, typename ToStr\u003e\\nclass Var : public VarBase {\\npublic:\\n    using Listener = std::function\u003cvoid(const T\u0026 oldVal, const T\u0026 newVal)\u003e;\\n    \\n    explicit Var(std::string name, std::string description = \\\"\\\")\\n        : m_name(std::move(name)), m_description(std::move(description)) {}\\n    \\n    std::string Name() const override {\\n        return m_name;\\n    }\\n    \\n    std::string Description() const override {\\n        return m_description;\\n    }\\n    \\n    T GetValue() const {\\n        std::shared_lock lock(m_mutex);\\n        return m_value;\\n    }\\n    \\n    void SetValue(const T\u0026 newVal) {\\n        std::unique_lock lock(m_mutex);\\n        if (m_value == newVal) return;\\n        \\n        const T oldVal = m_value;\\n        m_value = newVal;\\n        \\n        for (const auto\u0026 listener : m_listeners) {\\n            try {\\n                listener(oldVal, newVal);\\n            } catch (const std::exception\u0026 e) {\\n                std::cerr \u003c\u003c \\\"Listener exception: \\\" \u003c\u003c e.what() \u003c\u003c '\\\\n';\\n            }\\n        }\\n    }\\n    \\n    uint64_t AddListener(Listener listener) {\\n        std::unique_lock lock(m_mutex);\\n        uint64_t key = m_nextKey++;\\n        m_listeners[key] = std::move(listener);\\n        return key;\\n    }\\n    \\n    void RemoveListener(uint64_t key) {\\n        std::unique_lock lock(m_mutex);\\n        m_listeners.erase(key);\\n    }\\n    \\n    std::string ToString() const override {\\n        std::shared_lock lock(m_mutex);\\n        return ToStr::Convert(m_value);\\n    }\\n    \\n    void FromString(const std::string\u0026 str) override {\\n        std::unique_lock lock(m_mutex);\\n        m_value = FromStr::Convert(str);\\n    }\\n    \\nprivate:\\n    mutable std::shared_mutex m_mutex;\\n    T m_value{};\\n    std::string m_name;\\n    std::string m_description;\\n    uint64_t m_nextKey = 1;\\n    std::unordered_map\u003cuint64_t, Listener\u003e m_listeners;\\n};\\n\\n// Config class\\nclass Config {\\npublic:\\n    template\u003ctypename T\u003e\\n    std::shared_ptr\u003cVar\u003cT\u003e\u003e Lookup(const std::string\u0026 name) {\\n        std::unique_lock lock(m_mutex);\\n        auto it = m_vars.find(name);\\n        if (it == m_vars.end()) {\\n            throw std::invalid_argument(fmt::format(\\\"Variable '{}' not found\\\", name));\\n        }\\n        return std::static_pointer_cast\u003cVar\u003cT\u003e\u003e(it-\u003esecond);\\n    }\\n    \\n    template\u003ctypename T\u003e\\n    std::shared_ptr\u003cVar\u003cT\u003e\u003e Lookup(const std::string\u0026 name, const T\u0026 default_val) {\\n        std::unique_lock lock(m_mutex);\\n        auto it = m_vars.find(name);\\n        if (it == m_vars.end()) {\\n            auto var = std::make_shared\u003cVar\u003cT\u003e\u003e(name);\\n            var-\u003eSetValue(default_val);\\n            m_vars[name] = var;\\n            return var;\\n        }\\n        return std::static_pointer_cast\u003cVar\u003cT\u003e\u003e(it-\u003esecond);\\n    }\\n    \\n    void LoadYaml(const YAML::Node\u0026 node) {\\n        std::unique_lock lock(m_mutex);\\n        ExtractMembers(node, \\\"\\\", *this);\\n    }\\n    \\n    template\u003ctypename Visitor\u003e\\n    void Visit(Visitor visitor) {\\n        std::shared_lock lock(m_mutex);\\n        for (const auto\u0026 [name, var] : m_vars) {\\n            visitor(name, var);\\n        }\\n    }\\n    \\nprivate:\\n    mutable std::shared_mutex m_mutex;\\n    std::unordered_map\u003cstd::string, std::shared_ptr\u003cVarBase\u003e\u003e m_vars;\\n    \\n    static void ExtractMembers(const YAML::Node\u0026 node, const std::string\u0026 prefix, Config\u0026 config) {\\n        if (node.IsMap()) {\\n            for (const auto\u0026 kv : node) {\\n                std::string newPrefix = prefix.empty() ? kv.first.as\u003cstd::string\u003e() : prefix + \\\".\\\" + kv.first.as\u003cstd::string\u003e();\\n                ExtractMembers(kv.second,