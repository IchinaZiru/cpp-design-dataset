{"model":"gemma3:27b","created_at":"2026-08-11T10:22:56.3057533Z","response":"{\"units\": [\n{\n\"content\": \"#ifndef HEAP_TIMER_H\\n#define HEAP_TIMER_H\\n\\n#include \u003calgorithm\u003e\\n#include \u003ccassert\u003e\\n#include \u003cchrono\u003e\\n#include \u003ccompare\u003e\\n#include \u003cdeque\u003e\\n#include \u003cfunctional\u003e\\n#include \u003coptional\u003e\\n#include \u003cstdexcept\u003e\\n#include \u003cunordered_map\u003e\\n#include \\\"log.h\\\"\\n#include \\\"util.h\\\"\\n\\nnamespace ws {\\n\\nclass HeapTimer\u003cKey\u003e {\\npublic:\\n    using Clock = std::chrono::steady_clock;\\n    using TimeOutCallback = std::function\u003cvoid(const Key\u0026)\u003e;\\n\\nprivate:\\n    struct Node {\\n        Key key;\\n        Clock::time_point expiration;\\n        TimeOutCallback callback;\\n\\n        bool Expired() const noexcept {\\n            return Clock::now() \u003e= expiration;\\n        }\\n\\n        void Swap(Node\u0026 other) noexcept {\\n            std::swap(key, other.key);\\n            std::swap(expiration, other.expiration);\\n            std::swap(callback, other.callback);\\n        }\\n    };\\n\\n    log::Logger::Ptr logger_; \\n    std::unordered_map\u003cKey, std::size_t\u003e key_to_idx_; \\n    std::deque\u003cNode\u003e nodes_; \\n\\n    void Swap(std::size_t idx1, std::size_t idx2) noexcept {\\n        Node temp = nodes_[idx1];\\n        nodes_[idx1] = nodes_[idx2];\\n        nodes_[idx2] = temp;\\n\\n        key_to_idx_[nodes_[idx1].key] = idx1;\\n        key_to_idx_[nodes_[idx2].key] = idx2;\\n    }\\n\\n    void Adjust(const Key\u0026 key, Clock::time_point expiration, std::optional\u003cTimeOutCallback\u003e callback) {\\n        auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) {\\n            throw std::out_of_range(\\\"Key not found\\\");\\n        }\\n        std::size_t idx = it-\u003esecond;\\n        nodes_[idx].expiration = expiration;\\n        if(callback.has_value()){\\n          nodes_[idx].callback = callback.value();\\n        }\\n    }\\n\\n    Key RemoveByIndex(std::size_t idx) noexcept {\\n        Key key = nodes_[idx].key;\\n        if (nodes_.size() == 1) {\\n            nodes_.clear();\\n            key_to_idx_.erase(key);\\n        } else {\\n            Swap(idx, nodes_.size() - 1);\\n            nodes_.pop_back();\\n            key_to_idx_.erase(key);\\n        }\\n        return key;\\n    }\\n\\n    void ShiftUp(std::size_t idx) noexcept {\\n        while (idx \u003e 0) {\\n            auto parent_idx = Parent(idx);\\n            if (!parent_idx.has_value()) break;\\n            std::size_t p = parent_idx.value();\\n            if (nodes_[idx] \u003c= nodes_[p]) break;\\n            Swap(idx, p);\\n            idx = p;\\n        }\\n    }\\n\\n    void ShiftDown(std::size_t idx) noexcept {\\n        while (true) {\\n            auto child_idx = SmallChild(idx);\\n            if (!child_idx.has_value()) break;\\n            std::size_t c = child_idx.value();\\n            if (nodes_[idx] \u003c= nodes_[c]) break;\\n            Swap(idx, c);\\n            idx = c;\\n        }\\n    }\\n\\n    bool ValidIndex(std::size_t idx) const noexcept {\\n        return idx \u003c nodes_.size();\\n    }\\n\\n    std::optional\u003cstd::size_t\u003e Parent(std::size_t idx) const noexcept {\\n        if (idx == 0) return std::nullopt;\\n        return (idx - 1) / 2;\\n    }\\n\\n    std::optional\u003cstd::size_t\u003e SmallChild(std::size_t idx) const noexcept {\\n        std::size_t left = 2 * idx + 1;\\n        std::size_t right = 2 * idx + 2;\\n\\n        if (!ValidIndex(left)) return std::nullopt;\\n        if (!ValidIndex(right)) return left;\\n\\n        return (nodes_[left] \u003c= nodes_[right]) ? left : right;\\n    }\\n\\npublic:\\n    HeapTimer(log::Logger::Ptr logger = log::RootLogger()) noexcept : logger_(logger) {}\\n\\n    HeapTimer(HeapTimer\u0026\u0026) = delete;\\n    HeapTimer\u0026 operator=(HeapTimer\u0026\u0026) = delete;\\n    HeapTimer(const HeapTimer\u0026) = delete;\\n    HeapTimer\u0026 operator=(const HeapTimer\u0026) = delete;\\n\\n    void Adjust(const Key\u0026 key, Clock::duration expiration) {\\n        Adjust(key, Clock::now() + expiration);\\n    }\\n\\n    void Adjust(const Key\u0026 key, Clock::time_point expiration) {\\n        Adjust(key, expiration, std::nullopt);\\n    }\\n\\n    void Push(const Key\u0026 key, Clock::duration expiration, TimeOutCallback callback) noexcept {\\n        auto it = key_to_idx_.find(key);\\n        if (it != key_to_idx_.end()) {\\n            Adjust(key, Clock::now() + expiration, callback);\\n        } else {\\n            nodes_.emplace_back(key, Clock::now() + expiration, callback);\\n            key_to_idx_[key] = nodes_.size() - 1;\\n            ShiftUp(nodes_.size() - 1);\\n        }\\n    }\\n\\n    void Push(const Key\u0026 key, Clock::time_point expiration, TimeOutCallback callback) noexcept {\\n        auto it = key_to_idx_.find(key);\\n        if (it != key_to_idx_.end()) {\\n            Adjust(key, expiration, callback);\\n        } else {\\n            nodes_.emplace_back(key, expiration, callback);\\n            key_to_idx_[key] = nodes_.size() - 1;\\n            ShiftUp(nodes_.size() - 1);\\n        }\\n    }\\n\\n    void Tick() noexcept {\\n        while (!nodes_.empty() \u0026\u0026 nodes_[0].Expired()) {\\n            Key key = RemoveByIndex(0);\\n            try {\\n                nodes_[0].callback(key);\\n            } catch (const std::exception\u0026 e) {\\n                logger_-\u003eError(\\\"Callback threw exception: {}\\\", e.what());\\n            }\\n        }\\n    }\\n\\n    bool Remove(const Key\u0026 key) noexcept {\\n        auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) return false;\\n        std::size_t idx = it-\u003esecond;\\n        RemoveByIndex(idx);\\n        return true;\\n    }\\n\\n    void Invoke(const Key\u0026 key) {\\n        auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) {\\n            throw std::out_of_range(\\\"Key not found\\\");\\n        }\\n        std::size_t idx = it-\u003esecond;\\n        RemoveByIndex(idx);\\n        try {\\n            nodes_[0].callback(key);\\n        } catch (const std::exception\u0026 e) {\\n            logger_-\u003eError(\\\"Callback threw exception: {}\\\", e.what());\\n        }\\n    }\\n\\n    Key Pop() noexcept {\\n        assert(!nodes_.empty());\\n        return RemoveByIndex(0);\\n    }\\n\\n    void Clear() noexcept {\\n        nodes_.clear();\\n        key_to_idx_.clear();\\n    }\\n\\n    bool Contain(const Key\u0026 key) const noexcept {\\n        return key_to_idx_.find(key) != key_to_idx_.end();\\n    }\\n\\n    bool Empty() const noexcept {\\n        assert(nodes_.empty() == key_to_idx_.empty());\\n        return nodes_.empty();\\n    }\\n\\n    std::size_t Size() const noexcept {\\n        assert(nodes_.size() == key_to_idx_.size());\\n        return nodes_.size();\\n    }\\n\\n    Clock::duration ToNextTick() noexcept {\\n        Tick();\\n        if (nodes_.empty()) return Clock::duration::zero();\\n        return nodes_[0].expiration - Clock::now();\\n    }\\n};\\n\\n}\\n\\n#endif // HEAP_TIMER_H\",\n\"file_id\": \"F01\",\n\"unit_id\": \"U01\"\n}]\n}","done":true,"done_reason":"stop","context":[105,2430,107,229197,236780,2124,51355,237921,25352,64764,237457,3652,236924,237658,237495,38152,61514,34611,55635,238211,14606,237051,34855,23086,238219,241817,12547,236951,237748,239106,44675,51355,237051,240854,129445,25352,49391,236924,174705,237977,237748,239106,6805,236945,240174,237441,237051,34611,55635,238211,5077,117954,237010,236951,9266,240174,237441,97997,4042,83306,14606,237051,81554,49391,236924,2501,237748,239106,6805,9450,236951,240754,237122,239088,237731,236951,68343,237518,236951,23595,237050,237983,237311,2234,236951,238189,240199,237313,236951,237857,240121,238663,238921,242771,236951,68343,3063,85678,23595,237050,68343,67189,237