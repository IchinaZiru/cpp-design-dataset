{"model":"gemma3:27b","created_at":"2026-08-11T10:25:07.103407Z","response":"{\"units\": [\n{\n\"content\": \"#ifndef HEAPTIMER_H\\n#define HEAPTIMER_H\\n\\n#include \u003cdeque\u003e\\n#include \u003cfunctional\u003e\\n#include \u003cmap\u003e\\n#include \u003cchrono\u003e\\n#include \u003ciostream\u003e\\n\\nnamespace log {\\nclass Logger;\\ntypedef std::shared_ptr\u003cLogger\u003e Ptr;\\n}\\n\\nnamespace detail {\\n\\n}\\n\\ntemplate \u003ctypename Key\u003e\\nclass HeapTimer {\\npublic:\\n    using Clock = std::chrono::steady_clock;\\n    using TimeOutCallback = std::function\u003cvoid(const Key\u0026)\u003e;\\n\\nprivate:\\n    log::Logger::Ptr logger_; \\n    std::unordered_map\u003cKey, std::size_t\u003e key_to_idx_; \\n    std::deque\u003cNode\u003e nodes_; \\n\\npublic:\\n    HeapTimer(log::Logger::Ptr logger = log::RootLogger()) : logger_(logger) {}\\n\\n    void Adjust(const Key\u0026 key, Clock::duration expiration) {\\n        auto it = key_to_idx_.find(key);\\n        if (it != key_to_idx_.end()) {\\n            std::size_t index = it-\u003esecond;\\n            nodes_[index].expiration = Clock::now() + expiration;\\n            // TODO: Re-heapify\\n        }\\n    }\\n\\n    void Adjust(const Key\u0026 key, Clock::time_point expiration) {\\n        auto it = key_to_idx_.find(key);\\n        if (it != key_to_idx_.end()) {\\n            std::size_t index = it-\u003esecond;\\n            nodes_[index].expiration = expiration;\\n            // TODO: Re-heapify\\n        }\\n    }\\n\\n    void Push(const Key\u0026 key, Clock::duration expiration, TimeOutCallback callback) {\\n        if (key_to_idx_.count(key)) return;\\n\\n        nodes_.emplace_back(key, Clock::now() + expiration, callback);\\n        std::size_t index = nodes_.size() - 1;\\n        key_to_idx_[key] = index;\\n        ShiftUp(index);\\n    }\\n\\n    void Push(const Key\u0026 key, Clock::time_point expiration, TimeOutCallback callback) {\\n        if (key_to_idx_.count(key)) return;\\n\\n        nodes_.emplace_back(key, expiration, callback);\\n        std::size_t index = nodes_.size() - 1;\\n        key_to_idx_[key] = index;\\n        ShiftUp(index);\\n    }\\n\\n    void Tick() {\\n        while (!nodes_.empty()) {\\n            if (nodes_.front().Expired()) {\\n                Key key = nodes_.front().key;\\n                nodes_.front().callback(key);\\n                Pop();\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    bool Remove(const Key\u0026 key) {\\n        auto it = key_to_idx_.find(key);\\n        if (it == key_to_idx_.end()) return false;\\n\\n        std::size_t index = it-\u003esecond;\\n        Swap(index, nodes_.size() - 1);\\n        nodes_.pop_back();\\n        key_to_idx_.erase(it);\\n        ShiftDown(index);\\n        return true;\\n    }\\n\\n    void Invoke(const Key\u0026 key) {\\n        auto it = key_to_idx_.find(key);\\n        if (it != key_to_idx_.end()) {\\n            std::size_t index = it-\u003esecond;\\n            nodes_[index].callback(key);\\n            Pop();\\n        }\\n    }\\n\\n    Key Pop() {\\n        if (nodes_.empty()) throw std::runtime_error(\\\"Heap is empty\\\");\\n        Key key = nodes_.front().key;\\n        Remove(key);\\n        return key;\\n    }\\n\\n    void Clear() {\\n        nodes_.clear();\\n        key_to_idx_.clear();\\n    }\\n\\n    bool Contain(const Key\u0026 key) const {\\n        return key_to_idx_.count(key) \u003e 0;\\n    }\\n\\n    bool Empty() const {\\n        return nodes_.empty();\\n    }\\n\\n    std::size_t Size() const {\\n        return nodes_.size();\\n    }\\n\\n    Clock::duration ToNextTick() const {\\n        if (nodes_.empty()) return Clock::infinity();\\n\\n        Clock::time_point next_expiration = nodes_.front().expiration;\\n        return next_expiration - Clock::now();\\n    }\\n\\nprivate:\\n    void ShiftUp(std::size_t index) {\\n        while (index \u003e 0) {\\n            std::size_t parent_index = (index - 1) / 2;\\n            if (nodes_[index].expiration \u003c nodes_[parent_index].expiration) {\\n                Swap(index, parent_index);\\n                index = parent_index;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    void ShiftDown(std::size_t index) {\\n        std::size_t size = nodes_.size();\\n        while (true) {\\n            std::size_t left_child_index = 2 * index + 1;\\n            std::size_t right_child_index = 2 * index + 2;\\n            std::size_t smallest = index;\\n\\n            if (left_child_index \u003c size \u0026\u0026 nodes_[left_child_index].expiration \u003c nodes_[smallest].expiration) {\\n                smallest = left_child_index;\\n            }\\n\\n            if (right_child_index \u003c size \u0026\u0026 nodes_[right_child_index].expiration \u003c nodes_[smallest].expiration) {\\n                smallest = right_child_index;\\n            }\\n\\n            if (smallest != index) {\\n                Swap(index, smallest);\\n                index = smallest;\\n            } else {\\n                break;\\n            }\\n        }\\n    }\\n\\n    void Swap(std::size_t i, std::size_t j) {\\n        nodes_[i].Swap(nodes_[j]);\\n        key_to_idx_[nodes_[i].key] = i;\\n        key_to_idx_[nodes_[j].key] = j;\\n    }\\n\\n    struct Node {\\n        Key key;\\n        Clock::time_point expiration;\\n        TimeOutCallback callback;\\n\\n        Node() : key{}, expiration{Clock::now()}, callback{nullptr} {}\\n\\n        bool Expired() const {\\n            return Clock::now() \u003e= expiration;\\n        }\\n\\n        void Swap(Node\u0026 o) {\\n            std::swap(key, o.key);\\n            std::swap(expiration, o.expiration);\\n            std::swap(callback, o.callback);\\n        }\\n    };\\n};\\n\\n#endif // HEAPTIMER_H\",\n\"file_id\": \"F01\",\n\"unit_id\": \"U01\"\n}]}","done":true,"done_reason":"stop","context":[105,2430,107,229197,236780,2124,513