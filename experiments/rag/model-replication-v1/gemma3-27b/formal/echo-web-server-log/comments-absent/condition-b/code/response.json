{"model":"gemma3:27b","created_at":"2026-08-11T10:57:32.8205871Z","response":"{\"units\": [\n{\n\"content\": \"#ifndef WS_LOG_LOGGER_H\\n#define WS_LOG_LOGGER_H\\n\\n#include \u003cstring\u003e\\n#include \u003clist\u003e\\n#include \u003cmemory\u003e\\n#include \u003cchrono\u003e\\n#include \u003cdeque\u003e\\n#include \u003cmutex\u003e\\n#include \u003ccondition_variable\u003e\\n#include \u003coptional\u003e\\n\\nnamespace ws {\\nnamespace log {\\n\\nenum class Level {\\n  Debug,\\n  Info,\\n  Warn,\\n  Error,\\n  Fatal\\n};\\n\\nenum class AppenderType {\\n  StdOut,\\n  File\\n};\\n\\nclass Event {\\npublic:\\n  Event(Level level, std::string_view fileName, size_t lineNum, uint32_t threadId) : \\n    level_(level), fileName_(fileName), lineNum_(lineNum), threadId_(threadId)\\n  {}\\n\\n  Level Level() const { return level_; }\\n  std::string_view FileName() const { return fileName_; }\\n  size_t LineNum() const { return lineNum_; }\\n  uint32_t ThreadId() const { return threadId_; }\\n\\nprivate:\\n  Level level_;\\n  std::string_view fileName_;\\n  size_t lineNum_;\\n  uint32_t threadId_;\\n};\\n\\ntemplate \u003ctypename T\u003e\\nclass BlockDeque {\\npublic:\\n  BlockDeque(size_t capacity) : capacity_(capacity) {}\\n\\n  void PushBack(const T\u0026 item) {\\n    std::unique_lock\u003cstd::mutex\u003e lock(mutex_);\\n    deque_.push_back(item);\\n    condition_.notify_one();\\n  }\\n\\n  std::optional\u003cT\u003e Pop() {\\n    std::unique_lock\u003cstd::mutex\u003e lock(mutex_);\\n    condition_.wait(lock, [this] { return !deque_.empty(); });\\n    T item = deque_.front();\\n    deque_.pop_front();\\n    return item;\\n  }\\n\\nprivate:\\n  size_t capacity_; \\n  std::deque\u003cT\u003e deque_;\\n  std::mutex mutex_;\\n  std::condition_variable condition_;\\n};\\n\\nclass Formatter {\\npublic:\\n  Formatter(std::string_view pattern) : pattern_(pattern) {}\\n\\n  virtual std::string Format(const Level\u0026 level, const Event\u0026 event) = 0;\\n\\nprotected:\\n  std::string_view Pattern() const { return pattern_; }\\nprivate:\\n  std::string_view pattern_; \\n};\\n\\nclass Appender {\\npublic:\\n  Appender(std::shared_ptr\u003cFormatter\u003e formatter) : formatter_(formatter) {}\\n\\n  virtual void Log(const Level\u0026 level, const Event\u0026 event) = 0;\\n\\nprotected:\\n  Formatter::Ptr formatter_; \\n};\\n\\nclass Logger {\\npublic:\\n  Logger(std::string_view name, Level level, size_t capacity, bool async_) : \\n    name_(name), level_(level), capacity_(capacity), async_(async_)\\n  {\\n    if (async_) {\\n      event_deque_ = std::make_shared\u003cBlockDeque\u003cEvent::Ptr\u003e\u003e(capacity_);\\n      worker_thread_ = std::thread([this] { SyncLog(); });\\n    }\\n  }\\n\\n  ~Logger() {\\n    if (async_) {\\n      StopAsyncLogging();\\n      worker_thread_.join();\\n    }\\n  }\\n\\n  void Log(Event::Ptr event) {\\n    if (event-\u003eLevel() \u003e= level_) {\\n      LogInternal(event);\\n    }\\n  }\\n\\nprivate:\\n  void LogInternal(Event::Ptr event) {\\n    if (async_ \u0026\u0026 event_deque_) {\\n      event_deque_-\u003ePushBack(event);\\n    } else {\\n      SyncLog(event);\\n    }\\n  }\\n\\n  void SyncLog(Event::Ptr event = nullptr) {\\n    while (true) {\\n        std::shared_ptr\u003cEvent\u003e current_event;\\n        if (async_) {\\n            auto maybe_event = event_deque_-\u003ePop();\\n            if (!maybe_event) break; \\n            current_event = *maybe_event;\\n        } else {\\n          current_event = event;\\n        }\\n      // Process the event using appenders.\\n      for (const auto\u0026 appender : appenders_) {\\n        appender-\u003eLog(level_, *current_event);\\n      }\\n    }\\n  }\\n\\n  void StopAsyncLogging() {\\n    if (async_ \u0026\u0026 event_deque_) {\\n      // Signal the worker thread to exit.\\n    }\\n  }\\n\\npublic:\\n  std::string_view Name() const { return name_; }\\n  Level Level() const { return level_; }\\n  size_t Capacity() const { return capacity_; }\\n\\n  void AddAppender(std::shared_ptr\u003cAppender\u003e appender) {\\n    appenders_.push_back(appender);\\n  }\\nprivate:\\n  std::string_view name_;\\n  Level level_;\\n  size_t capacity_;\\n  bool async_;\\n  std::list\u003cstd::shared_ptr\u003cAppender\u003e\u003e appenders_;\\n  std::shared_ptr\u003cBlockDeque\u003cEvent::Ptr\u003e\u003e event_deque_; \\n  std::thread worker_thread_;\\n};\\n\\n}\\n} // namespace ws::log\\n\\n#endif\",\n\"file_id\": \"F01\",\n\"unit_id\": \"U01\"\n},\n{\n\"content\": \"template \u003ctypename T\u003e\\nvoid ThrowIfYamlFieldIsNotScalar(const YAML::Node\u0026 node, std::string_view field) {\\n  if (!node[field].IsScalar()) {\\n    throw std::runtime_error(\\\"YAML field '\\\" + std::string(field) + \\\"' is not scalar.\\\");\\n  }\\n}\",\n\"file_id\": \"F02\",\n\"unit_id\": \"U02\"\n},\n{\n\"content\": \"#include \u003cfmt/format.h\u003e\\n#include \u003ciostream\u003e\\n#include \u003cfstream\u003e\\n#include \u003cstring\u003e\\n\\nnamespace ws {\\nnamespace cfg {\\n\\nYAML::Node LoadYamlString(std::string_view str, std::initializer_list\u003cstd::string_view\u003e required_fields) {\\n  YAML::Node node = YAML::Load(str);\\n  for (const auto\u0026 field : required_fields) {\\n    if (!node[field]) {\\n      throw std::runtime_error(\\\"Required YAML field '\\\" + std::string(field) + \\\"' is missing.\\\");\\n    }\\n  }\\n  return node;\\n}\\n\\nvoid ThrowIfYamlFieldIsNotScalar(const YAML::Node\u0026 node, std::string_view field);\\n\\n}\\n} // namespace ws::cfg\",\n\"file_id\": \"F03\",\n\"unit_id\": \"U03\"\n},\n{\n\"content\": \"#include \u003costream\u003e\\nnamespace ws {\\nnamespace log {\\n\\nstd::ostream\u0026 operator\u003c\u003c(std::ostream\u0026 os, const Level level) noexcept {\\n  switch (level) {\\n    case Level::Debug:   os \u003c\u003c \\\"DEBUG\\\"; break;\\n    case Level::Info:    os \u003c\u003c \\\"INFO\\\";  break;\\n    case Level::Warn:    os \u003c\u003c \\\"WARN\\\";  break;\\n    case Lev