{"model":"gemma3:27b","created_at":"2026-08-11T10:55:24.0500369Z","response":"{\"units\": [\n  {\n    \"content\": \"#ifndef LOG_H\\n#define LOG_H\\n\\n#include \u003cchrono\u003e\\n#include \u003cexperimental/source_location\u003e\\n#include \u003cfstream\u003e\\n#include \u003ciostream\u003e\\n#include \u003cstring\u003e\\n#include \u003cstring_view\u003e\\n#include \u003csstream\u003e\\n#include \u003cthread\u003e\\n#include \u003cmutex\u003e\\n#include \u003cdeque\u003e\\n\\nnamespace logging {\\n\\nenum class Level {\\n    Debug,\\n    Info,\\n    Warn,\\n    Error,\\n    Fatal\\n};\\n\\nenum class AppenderType {\\n    StdOut,\\n    File\\n};\\n\\nclass Event {\\npublic:\\n    static Event Create(Level level, const std::source_location\u0026 location, std::thread::id thread_id);\\n\\n    Event(const Event\u0026) = delete;\\n    Event\u0026 operator=(const Event\u0026) = delete;\\n\\n    Level GetLevel() const { return level_; }\\n    std::string_view GetFileName() const { return file_name_; }\\n    int GetLineNumber() const { return line_num_; }\\n    std::thread::id GetThreadId() const { return thread_id_; }\\n    std::chrono::system_clock::time_point GetTime() const { return time_; }\\n    std::string_view GetMessage() const { return msg_; }\\n\\nprivate:\\n    Level level_; \\n    std::string_view file_name_; \\n    int line_num_; \\n    std::thread::id thread_id_; \\n    std::chrono::system_clock::time_point time_; \\n    std::string_view msg_; \\n\\n    std::ostringstream message_stream_; // Used to build the message.\\n};\\n\\nclass Formatter {\\npublic:\\n    static Formatter Default();\\n\\n    Formatter(const std::string\u0026 pattern);\\n\\n    std::string Format(const Event\u0026 event) const;\\n    std::string_view Pattern() const { return pattern_; }\\n\\nprivate:\\n    std::string pattern_; \\n    //std::vector\u003cField*\u003e fields_; // Fields to extract data from the event.\\n};\\n\\nclass Formatter::Field {\\npublic:\\n    virtual ~Field() = default;\\n    virtual std::string Format(const Event\u0026 event) const = 0;\\n    virtual std::string_view Tag() const = 0;\\n};\\n\\nclass Appender {\\npublic:\\n    Appender(Formatter formatter);\\n    virtual ~Appender() = default;\\n\\n    virtual void Log(const Event\u0026 event) = 0;\\n    std::string ToYamlString() const; \\n    Formatter GetFormatter() const { return formatter_; }\\n    void SetFormatter(Formatter formatter); \\nprivate:\\n    Formatter formatter_;\\n};\\n\\nclass StdOutAppender : public Appender {\\npublic:\\n    StdOutAppender(Formatter formatter) : Appender(formatter) {}\\n    void Log(const Event\u0026 event) override;\\n};\\n\\nclass FileAppender : public Appender {\\npublic:\\n    FileAppender(Formatter formatter, const std::string\u0026 file_name);\\n    void Log(const Event\u0026 event) override;\\nprivate:\\n    std::string file_name_; \\n    std::ofstream file_; \\n};\\n\\nclass Logger {\\npublic:\\n    Logger(const std::string\u0026 name, Level level = Level::Info, size_t capacity = 1024, bool async = false);\\n    ~Logger();\\n\\n    void Log(Level level, const std::string_view\u0026 message);\\n    void AddAppender(Appender* appender);\\n    void RemoveAppender(Appender* appender);\\n    void ClearAppenders();\\n    Level GetLevel() const { return level_; }\\n    void SetLevel(Level level); \\n    Formatter GetDefaultFormatter() const { return formatter_ };\\n    void SetDefaultFormatter(Formatter formatter); \\n    std::string ToYamlString() const; \\nprivate:\\n    void AsyncLogProc();\\n\\n    std::string name_; \\n    Level level_; \\n    size_t capacity_; \\n    bool async_; \\n    std::deque\u003cEvent\u003e event_deque_; \\n    std::thread writer_thread_; \\n    std::vector\u003cAppender*\u003e appenders_; \\n    Formatter formatter_;\\n};\\n\\nclass EventWriter {\\npublic:\\n    EventWriter(Logger\u0026 logger, Level level, const std::string_view\u0026 message);\\n    ~EventWriter();\\nprivate:\\n    Logger\u0026 logger_; \\n    Level level_; \\n    std::string_view message_; \\n};\\n\\nclass Manager {\\npublic:\\n    Manager(const std::string\u0026 name);\\n    ~Manager();\\n\\n    Logger* FindLogger(const std::string\u0026 logger_name); \\n    void RemoveLogger(const std::string\u0026 logger_name);\\n    std::string ToYamlString() const; \\nprivate:\\n    std::string name_; \\n    std::map\u003cstd::string, Logger\u003e loggers_; \\n};\\n\\n}\\n#endif // LOG_H\",\n    \"file_id\": \"F01\",\n    \"unit_id\": \"U01\"\n  },\n  {\n    \"content\": \"#include \\\"log.h\\\"\\n\\nnamespace logging {\\n\\nEvent Event::Create(Level level, const std::source_location\u0026 location, std::thread::id thread_id) {\\n    return Event {level, location.file_name(), location.line(), thread_id, std::chrono::system_clock::now(), \\\"\\\"};\\n}\\n\\nFormatter Formatter::Default() {\\n    return Formatter(\\\"%t %l: %m\\\");\\n}\\n\\nFormatter::Formatter(const std::string\u0026 pattern) : pattern_(pattern) {}\\n\\nstd::string Formatter::Format(const Event\u0026 event) const {\\n    std::stringstream ss;\\n    // Implement formatting logic here based on the pattern and event data.\\n    ss \u003c\u003c \\\"Formatted message for level: \\\" \u003c\u003c static_cast\u003cint\u003e(event.GetLevel()) \u003c\u003c \\\", message: \\\" \u003c\u003c event.GetMessage();\\n    return ss.str();\\n}\\n\\nAppender::Appender(Formatter formatter) : formatter_(formatter) {}\\n\\nstd::string Appender::ToYamlString() const {\\n    return \\\"{\\\\\\\"type\\\\\\\": \\\\\\\"appender\\\\\\\", \\\\\\\"formatter\\\\\\\": \\\\\\\"\\\" + formatter_.Pattern() + \\\"\\\\\\\"}\\\";\\n}\\n\\nvoid Appender::SetFormatter(Formatter formatter) {\\n    formatter_ = formatter;\\n}\\n\\nvoid StdOutAppender::Log(const Event\u0026 event) {\\n    std::cout \u003c\u003c formatter_.Format(event) \u003c\u003c std::endl;\\n}\\n\\nFileAppender::FileAppender(Formatter formatter, const std::string\u0026 file_name) : Appender(formatter), file_name_(file_name) {\\n    file_.open(file_name_, std::ios::app);\\n    if (!file_.is_open()) {\\n        throw std::runtime_error(\\\"Failed to open file: \\\" + file_name_);\\n    }\\n}\\n\\nvoid FileAppender::Log(const Event\u0026 event) {\\n    file_ \u003c\u003c formatter_.Format(event) \u003c\u003c std::endl;\\n    file_.flush();\\n}\\n\\nLogger::Logger(const std::string\u0026 name, Level level, size_t capacity, bool async) : \\n    name_(name), level_(level), capacity_(capacity), async_(async), formatter_(Formatter::Default()) {\\n    if (async_) {\\n        writer_thread_ = std::thread(\u0026Logger::AsyncLogProc, this);\\n    }\\n}\\n\\nLogger::~Logger() {\\n    if (async_) {\\n        writer_thread_.join();\\n    }\\n    for (auto* appender : appenders_) {\\n        delete appender;\\n    }\\n}\\n\\nvoid Logger::Log(Level level, const std::string_view\u0026 message) {\\n    Event event = Event::Create(level, std::source_location::current(), std::this_thread::get_id());\\n    //event.GetMessageStream() \u003c\u003c message;\\n    //Event final_event = event;\\n    Log(event);\\n}\\n\\nvoid Logger::Log(const Event\u0026 event) {\\n    if (level_ \u003c= event.GetLevel()) {\\n        for (auto* appender : appenders_) {\\n            appender-\u003eLog(event);\\n        }\\n    }\\n}\\n\\nvoid Logger::AddAppender(Appender* appender) {\\n    appenders_.push_back(appender);\\n}\\n\\nvoid Logger::RemoveAppender(Appender* appender) {\\n    // Implement removal logic here.\\n}\\n\\nvoid Logger::ClearAppenders() {\\n    appenders_.clear();\\n}\\n\\nstd::string Logger::ToYamlString() const {\\n    return \\\"{\\\\\\\"type\\\\\\\": \\\\\\\"logger\\\\\\\", \\\\\\\"name\\\\\\\": \\\\\\\"\\\" + name_ + \\\"\\\\\\\", \\\\\\\"level\\\\\\\": \\\\\\\"\\\" + static_cast\u003cstd::string\u003e(static_cast\u003cint\u003e(level_)) + \\\"\\\\\\\"}\\\";\\n}\\n\\nvoid Logger::AsyncLogProc() {\\n    while (true) {\\n        Event event;\\n        {\\n            std::lock_guard\u003cstd::mutex\u003e lock(event_deque_mutex_);\\n            if (!event_deque_.empty()) {\\n                event = event_deque_.front();\\n                event_deque_.pop_front();\\n            }\\n        }\\n        Log(event);\\n    }\\n}\\n\\nEventWriter::EventWriter(Logger\u0026 logger, Level level, const std::string_view\u0026 message) : \\n    logger_(logger), level_(level), message_(message) {\\n    logger_.Log(level_, message_);\\n}\\n\\nEventWriter::~EventWriter() {}\\n\\nManager::Manager(const std::string\u0026 name) : name_(name) {}\\n\\nManager::~Manager() {}\\n\\nLogger* Manager::FindLogger(const std::string\u0026 logger_name) {\\n    auto it = loggers_.find(logger_name);\\n    if (it != loggers_.end()) {\\n        return \u0026it-\u003esecond;\\n    }\\n    return nullptr;\\n}\\n\\nvoid Manager::RemoveLogger(const std::string\u0026 logger_name) {\\n    loggers_.erase(logger_name);\\n}\\n\\nstd::string Manager::ToYamlString() const {\\n    return \\\"{\\\\\\\"type\\\\\\\": \\\\\\\"manager\\\\\\\", \\\\\\\"name\\\\\\\": \\\\\\\"\\\" + name_ + \\\"\\\\\\\"}\\\";\\n}\\n}\",\n    \"file_id\": \"F02\",\n    \"unit_id\": \"U02\"\n  },\n  {\n    \"content\": \"#ifndef APPENDER_H\\n#define APPENDER_H\\n\\n#include \u003cstring\u003e\\n#include \u003cfstream\u003e\\n#include \u003cvector\u003e\\n#include \\\"log.h\\\"\\n\\nnamespace logging {\\n\\nclass Appender {\\npublic:\\n    Appender(Formatter formatter);\\n    virtual ~Appender() = default;\\n\\n    virtual void Log(const Event\u0026 event) = 0;\\n    std::string ToYamlString() const; \\n    Formatter GetFormatter() const; \\n    void SetFormatter(Formatter formatter); \\nprivate:\\n    Formatter formatter_;\\n};\\n\\nclass StdOutAppender : public Appender {\\npublic:\\n    StdOutAppender(Formatter formatter);\\n    void Log(const Event\u0026 event) override;\\n};\\n\\nclass FileAppender : public Appender {\\npublic:\\n    FileAppender(Formatter formatter, const std::string\u0026 file_name);\\n    void Log(cons