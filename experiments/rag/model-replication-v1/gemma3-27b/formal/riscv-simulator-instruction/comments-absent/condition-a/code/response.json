\\\";\\n            case Type::B:\\n                return key != \\\"rd\\\" \u0026\u0026 key != \\\"funct7\\\";\\n            case Type::U:\\n                return key != \\\"rs1\\\" \u0026\u0026 key != \\\"rs2\\\" \u0026\u0026 key != \\\"funct3\\\" \u0026\u0026 key != \\\"funct7\\\";\\n            case Type::J:\\n                return key != \\\"rs1\\\" \u0026\u0026 key != \\\"rs2\\\" \u0026\u0026 key != \\\"funct3\\\" \u0026\u0026 key != \\\"funct7\\\";\\n            default:\\n                return false;\\n        }\\n    }\\n\\n    void verify(const std::string \u0026key) const {\\n        if (!is_valid(key)) {\\n            throw InvalidAccess(\\\"Invalid access to field: \\\" + key);\\n        }\\n    }\\n\\n    virtual void debug() const {\\n        std::cout \u003c\u003c \\\"0x\\\" \u003c\u003c std::hex \u003c\u003c inst \u003c\u003c \\\":\\\";\\n        switch (t) {\\n            case Type::R:\\n                std::cout \u003c\u003c \\\" R-type\\\";\\n                break;\\n            case Type::I:\\n                std::cout \u003c\u003c \\\" I-type\\\";\\n                break;\\n            case Type::S:\\n                std::cout \u003c\u003c \\\" S-type\\\";\\n                break;\\n            case Type::B:\\n                std::cout \u003c\u003c \\\" B-type\\\";\\n                break;\\n            case Type::U:\\n                std::cout \u003c\u003c \\\" U-type\\\";\\n                break;\\n            case Type::J:\\n                std::cout \u003c\u003c \\\" J-type\\\";\\n                break;\\n        }\\n        std::cout \u003c\u003c std::endl;\\n    }\\n\\n    bool has_op1() const {\\n        return t != Type::U \u0026\u0026 t != Type::J;\\n    }\\n\\n    bool has_op2() const {\\n        return t == Type::R || t == Type::S || t == Type::B;\\n    }\\n};\\n\\nclass InstructionR : public InstructionBase {\\npublic:\\n    InstructionR(Instruction inst) : InstructionBase(inst) {\\n        opcode = get_digits(inst, 6, 0);\\n   