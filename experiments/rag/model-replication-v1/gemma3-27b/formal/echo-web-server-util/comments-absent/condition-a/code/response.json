cktrace Functions (F01/U01, F02/U02)\\nstd::uint32_t CurrentThreadId() noexcept;\\nvoid Backtrace(std::vector\u003cstd::string\u003e\u0026 stack, std::size_t size, std::size_t skip = 0) noexcept;\\nstd::string Backtrace(std::size_t size, std::size_t skip = 0, std::string_view prefix = \\\"\\\") noexcept;\\n\\n// Smart Pointers \u0026 RAII Helpers (F01/U01)\\ntemplate \u003ctypename T, typename... Args\u003e\\nclass Singleton {\\npublic:\\n  static T\u0026 Instance() noexcept {\\n    static T instance(Args()...);\\n    return instance;\\n  }\\n};\\n\\ntemplate \u003ctypename T, typename... Args\u003e\\nclass SingletonPtr {\\npublic:\\n  static std::shared_ptr\u003cT\u003e Instance() noexcept {\\n    static auto instance = std::make_shared\u003cT\u003e(Args()...);\\n    return instance;\\n  }\\n};\\n\\ntemplate \u003ctypename T, typename Cleaner\u003e\\nclass RAII {\\npublic:\\n  RAII(T obj, Cleaner cleaner) : obj_(obj), cleaner_(cleaner) {}\\n  ~RAII() { cleaner_(obj_); }\\n  const T\u0026 Object() const noexcept { return obj_; }\\n\\nprivate:\\n  T obj_;\\n  Cleaner cleaner_;\\n};\\n\\n// MappedReadOnlyFile Class (F01/U01, F02/U02)\\nclass MappedReadOnlyFile {\\npublic:\\n  MappedReadOnlyFile() = default;\\n  MappedReadOnlyFile(const MappedReadOnlyFile\u0026) = delete;\\n  MappedReadOnlyFile\u0026 operator=(const MappedReadOnlyFile\u0026) = delete;\\n  MappedReadOnlyFile(MappedReadOnlyFile\u0026\u0026) noexcept {}\\n\\n  ~MappedReadOnlyFile();\\n\\n  std::byte* Map(std::string path);\\n  void Unmap() noexcept;\\n  size_t Size() const noexcept;\\n  const std::byte* Data() const noexcept;\\n  std::string_view Path() const noexcept;\\n\\nprivate:\\n  void Check() const;\\n  std::byte* mapped_data_ = nullptr;\\n  size_t file_size_ = 0;\\n  std::string file_path_;\\n};\\n\\ntemplate \u003ctypename T, typename U, typename Ret\u003e\\nconcept Addable = requires(T a, U b) {\\n  {a + b} -\u003e std::convertible_to\u003cRet\u003e;\\n};\\n\\n}\\n#endif // WS_UTIL_H\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    },\n    {\n      \"content\": \"#include \\\"util.h\\\"\\n\\nstd::string ws::StringToLower(std::string str) noexcept {\\n  std::transform(str.begin(), str.end(), str.begin(), ::tolower);\\n  return str;\\n}\\n\\nstd::string ws::StringToUpper(std::string str) noexcept {\\n  std::transform(str.begin(), str.end(), str.begin(), ::toupper);\\n  return str;\\n}\\n\\nstd::string ws::ReplaceAllSubstring(std::string_view str, std::string_view from, std::string_view to) noexcept {\\n  std::string result = std::string(str);\\n  size_t pos = 0;\\n  while ((pos = result.find(from, pos)) != std::string::npos) {\\n    result.replace(pos, from.length(), to);\\n    pos += to.length();\\n  }\\n  return result;\\n}\\n\\nstd::vector\u003cstd::string\u003e ws::SplitString(const std::string\u0026 str, const std::regex\u0026 pattern) noexcept {\\n  std::vector\u003cstd::string\u003e result;\\n  std::sregex_token_iterator it(str.begin(), str.end(), pattern, -1);\\n  std::sregex_token_iterator end;\\n  while (it != end) {\\n    result.push_back(*it++);\\n  }\\n  return result;\\n}\\n\\nstd::vector\u003cstd::string\u003e ws::SplitStringToLines(const std::string\u0026 str) noexcept {\\n  std::regex newline_regex(\\\"\\\\r*\\\\n\\\");\\n  return SplitString(str, newline_regex);\\n}\\n\\nYAML::Node ws::LoadYamlString(std::string_view str, std::initializer_list\u003cstd::string_view\u003e required_fields) {\\n  YAML::Node node = YAML::Load(str.data());\\n  for (const auto\u0026 field : required_fields) {\\n    if (!node[field]) {\\n      throw std::invalid_argument(\\\"Required field '\\\" + std::string(field) + \\\"' not found in YAML.\\\");\\n    }\\n  }\\n  return node;\\n}\\n\\nvoid ws::ThrowIfYamlFieldIsNotScalar(const YAML::Node\u0026 node, std::string_view field) {\\n  if (!node[field].IsScalar()) {\\n    throw std::invalid_argument(\\\"YAML field '\\\" + std::string(field) + \\\"' is not a scalar.\\\");\\n  }\\n}\\n\\nbool ws::IsValidFileDescriptor(FileDescriptor fd) noexcept {\\n  return fd \u003e= 0;\\n}\\n\\nvoid ws::SetFileDescriptorAsNonblocking(FileDescriptor fd) {\\n  if (fcntl(fd, F_SETFL, O_NONBLOCK) == -1) {\\n    ThrowLastSystemError();\\n  }\\n}\\n\\nvoid ws::ThrowLastSystemError() {\\n  throw std::system_error(errno, std::system_category(), \\\"System error occurred.\\\");\\n}\\n\\nstd::uint32_t ws::CurrentThreadId() noexcept {\\n  return syscall(__NR_gettid());\\n}\\n\\nvoid ws::Backtrace(std::vector\u003cstd::string\u003e\u0026 stack, std::size_t size, std::size_t skip) noexcept {\\n  void* addrlist[size + skip];\\n  int addrlen = backtrace(addrlist, static_cast\u003cint\u003e(size + skip));\\n  if (addrlen \u003e 0) {\\n    char** symbollist = backtrace_symbols(addrlist, addrlen);\\n    if (symbollist != nullptr) {\\n      for (int i = skip; i \u003c addrlen; ++i) {\\n        stack.push_back(symbollist[i]);\\n      }\\n      free(symbollist);\\n    }\\n  }\\n}\\n\\nstd::string ws::Backtrace(std::size_t size, std::size_t skip, std::string_view prefix) noexcept {\\n  std::vector\u003cstd::string\u003e stack;\\n  Backtrace(stack, size, skip);\\n  std::stringstream ss;\\n  for (const auto\u0026 line : stack) {\\n    ss \u003c\u003c prefix \u003c\u003c line \u003c\u003c \\\"\\\\n\\\";\\n  }\\n  return ss.str();\\n}\\n\\nMappedReadOnlyFile::~MappedReadOnlyFile() {\\n  Unmap();\\n}\\n\\nstd::byte* MappedReadOnlyFile::Map(std::string path) {\\n  file_path_ = std::move(path);\\n  int fd = open(file_path_.c_str(), O_RDONLY);\\n  if (fd == -1) {\\n    ThrowLastSystemError();\\n  }\\n\\n  struct stat sb;\\n  if (fstat(fd, \u0026sb) == -1) {\\n    close(fd);\\n    ThrowLastSystemError();\\n  }\\n\\n  file_size_ = sb.st_size;\\n  mapped_data_ = static_cast\u003cstd::byte*\u003e(mmap(nullptr, file_size_, PROT_READ, MAP_PRIVATE, fd, 0));\\n  if (mapped_data_ == MAP_FAILED) {\\n    close(fd);\\n    ThrowLastSystemError();\\n  }\\n\\n  close(fd);\\n  return mapped_data_;\\n}\\n\\nvoid MappedReadOnlyFile::Unmap() noexcept {\\n  if (mapped_data_ != nullptr) {\\n    munmap(mapped_data_, file_size_);\\n    mapped_data_ = nullptr;\\n    file_size_ = 0;\\n  }\\n}\\n\\nsize_t MappedReadOnlyFile::Size() const noexcept {\\n  return file_size_;\\n}\\n\\nconst std::byte* MappedReadOnlyFile::Data() const noexcept {\\n  return mapped_data_;\\n}\\n\\nstd::string_view MappedReadOnlyFile::Path() const noexcept {\\n  return file_path_;\\n}\\n\\nvoid MappedReadOnlyFile::Check() const {\\n  // Implement file path and permission checks here if needed.\\n}\\n\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[105,2430,107,229197,236780,2124,51355,237921,25352,64764,237457,3652,236924,237658,237495,38152,61514,34611,55635,238211,14606,237051,34855,23086,238219,241817,12547,236951,237748,239106,44675,51355,237051,240854,129445,25352,49391,236924,174705,237977,237748,239106,6805,236945,240174,237441,237051,34611,55635,238211,5077,117954,237010,236951,9266,240174,237441,97997,4042,83306,14606,237051,81554,49391,236924,2501,237748,239106,6805,9450,236951,240754,237122,239088,237731,236951,68343,237518,236951,23595,237050,237983,237311,2234,236951,238189,240199,237313,236951,237857,240121,238663,238921,242771,236951,68343,3063,85678,23595,237050,68343,67189,237051,25352,237010,236951,3063,57544,237364,14606,87580,237473,3335,45621,237406,13772,236924,10602,236772,2164,46179,7498,236772,2164,237748,239106,6805,9450,236951,3917,9200,46179,36641,236951,80395,3917,236951,10699,236951,3091,236951,237731,164683,236951,95522,71924,236951,95522,9892,167023,236951,239050,238460,85678,23595,237050,195214,25352,49391,236924,21695,23086,68343,111166,236951,164683,14606,236951,46179,40844,37899,13850,14606,87580,237473,3335,45621,237406,13772,236924,10602,236772,2164,236786,7498,236772,2164,9450,3917,237512,10699,237156,237748,239106,6805,76443,30786,70381,238446,237505,236951,2501,236786,12247,236772,1688,74168,120531,51355,2380