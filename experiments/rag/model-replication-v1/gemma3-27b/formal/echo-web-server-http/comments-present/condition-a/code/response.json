{"model":"gemma3:27b","created_at":"2026-08-11T10:30:54.3393078Z","response":"{\n  \"units\": [\n    {\n      \"content\": \"#ifndef WS_HTTP_H\\n#define WS_HTTP_H\\n\\n#include \u003ciostream\u003e\\n#include \u003cstring\u003e\\n#include \u003cunordered_map\u003e\\n#include \u003cfilesystem\u003e\\n#include \u003coptional\u003e\\n#include \u003ccstdint\u003e\\n#include \u003csystem_error\u003e\\n\\nnamespace ws::http {\\n\\nconstexpr const char* version = \\\"1.1\\\";\\n\\nenum class StatusCode : std::uint32_t {\\n    OK = 200,\\n    BadRequest = 400,\\n    Forbidden = 403,\\n    NotFound = 404\\n};\\n\\nenum class Method {\\n    Get,\\n    Post,\\n    Put,\\n    Patch,\\n    Delete\\n};\\n\\nusing Parameters = std::unordered_map\u003cstd::string, std::string\u003e;\\n\\nStatusCodeToMessage(StatusCode code) noexcept;\\nStatusCodeToInteger(StatusCode code) noexcept;\\nstd::ostream\u0026 operator\u003c\u003c(std::ostream\u0026 os, StatusCode code) noexcept;\\n\\nMethodToString(Method method) noexcept;\\nStringToMethod(std::string str) throw(std::invalid_argument);\\nstd::ostream\u0026 operator\u003c\u003c(std::ostream\u0026 os, Method method) noexcept;\\n\\nconstexpr const char* new_line = \\\"\\\\r\\\\n\\\";\\n\\nContentTypeByFileName(std::string_view name) noexcept;\\nDecodeURLEncodedCharacter(const std::string\u0026 str) throw(std::invalid_argument);\\nDecodeURLEncodedString(const std::string\u0026 str) throw(std::invalid_argument);\\nHTMLPlaceholder(std::string_view key) noexcept;\\nPutParamIntoHTML(std::string html, const Parameters\u0026 params);\\n\\nclass ConnectionImpl {\\npublic:\\n    virtual ~ConnectionImpl() = default;\\n\\nprivate:\\n    int socket_; // File descriptor of the socket.\\n    bool keep_alive_; // Flag indicating whether to keep the connection alive.\\n    std::string read_buf_; // Buffer for reading data from the socket.\\n    std::string write_buf_; // Buffer for writing data to the socket.\\n    std::filesystem::path file_; // Path to the requested file.\\n\\npublic:\\n    static void SetRootDirectory(std::filesystem::path dir) noexcept;\\n    static std::filesystem::path GetRootDirectory() noexcept;\\n\\n    ConnectionImpl() = delete;\\n    ConnectionImpl(const ConnectionImpl\u0026) = delete;\\n    ConnectionImpl\u0026 operator=(const ConnectionImpl\u0026) = delete;\\n    ConnectionImpl(ConnectionImpl\u0026\u0026) = delete;\\n    ConnectionImpl\u0026 operator=(ConnectionImpl\u0026\u0026) = delete;\\n\\n    void Close() noexcept;\\n    bool Valid() const noexcept;\\n    int Socket() const noexcept;\\n    size_t Receive();\\n    size_t Send();\\n    bool KeepAlive() const noexcept;\\n    bool Process();\\n};\\n\\ntemplate \u003ctypename ValidIPAddr\u003e\\nclass Connection : public ConnectionImpl {\\npublic:\\n    Connection(ValidIPAddr addr) : addr_(addr) {}\\n\\nprivate:\\n    ValidIPAddr addr_; // IP address of the client.\\n\\npublic:\\n    const ValidIPAddr\u0026 Address() const noexcept { return addr_; }\\n    uint16_t Port() const noexcept { return addr_.port(); }\\n};\\n\\n}\\n\\n#endif\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    },\n    {\n      \"content\": \"// Implementation for http.h functions and ConnectionImpl methods.\\n// This file is intentionally left blank as per the instructions.\\n\\n#include \\\"http.h\\\"\\n\\nStatusCodeToMessage(StatusCode code) noexcept {\\n  return StatusCodeToMessage(code);\\n}\\n\\nStatusCodeToInteger(StatusCode code) noexcept {\\n  return StatusCodeToInteger(code);\\n}\\n\\nstd::ostream\u0026 operator\u003c\u003c(std::ostream\u0026 os, StatusCode code) noexcept {\\n    return os \u003c\u003c static_cast\u003cint\u003e(code);\\n}\\n\\nMethodToString(Method method) noexcept {\\n  return MethodToString(method);\\n}\\n\\nStringToMethod(std::string str) throw(std::invalid_argument) {\\n  return StringToMethod(str);\\n}\\n\\nstd::ostream\u0026 operator\u003c\u003c(std::ostream\u0026 os, Method method) noexcept {\\n    return os \u003c\u003c static_cast\u003cint\u003e(method);\\n}\\n\\nContentTypeByFileName(std::string_view name) noexcept {\\n  return ContentTypeByFileName(name);\\n}\\n\\nDecodeURLEncodedCharacter(const std::string\u0026 str) throw(std::invalid_argument) {\\n    return DecodeURLEncodedCharacter(str);\\n}\\n\\nDecodeURLEncodedString(const std::string\u0026 str) throw(std::invalid_argument) {\\n  return DecodeURLEncodedString(str);\\n}\\n\\nHTMLPlaceholder(std::string_view key) noexcept {\\n    return HTMLPlaceholder(key);\\n}\\n\\nPutParamIntoHTML(std::string html, const Parameters\u0026 params) {\\n    return PutParamIntoHTML(html, params);\\n}\\n\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    },\n    {\n      \"content\": \"#ifndef WS_HTTP_REQUEST_H\\n#define WS_HTTP_REQUEST_H\\n\\n#include \u003cstring_view\u003e\\n#include \u003coptional\u003e\\n#include \u003cbuffer\u003e\\n\\nnamespace ws::http {\\n\\nclass Request {\\npublic:\\n    enum class State {\\n        NotStarted,\\n        Header,\\n        Body,\\n        Finished\\n    };\\n\\n    class NotStarted {};\\n    class Header {};\\n    class Body {};\\n    class Finished {};\\n\\n    Request() : state_(State::NotStarted) {}\\n\\n    void Parse(Buffer\u0026 buf) throw(std::invalid_argument);\\n\\n    std::optional\u003cstd::string_view\u003e Header(std::string_view key) const noexcept;\\n    std::optional\u003cstd::string_view\u003e Post(std::string_view key) const noexcept;\\n    size_t PostSize() const noexcept;\\n    std::string Method() const noexcept;\\n    std::string Path() const noexcept;\\n    std::string Version() const noexcept;\\n    bool KeepAlive() const noexcept;\\n\\nprivate:\\n    State state_; // Current parsing state.\\n    std::string method_; // HTTP request method (GET, POST, etc.).\\n    std::string path_; // Requested path.\\n    std::string version_; // HTTP version.\\n    std::unordered_map\u003cstd::string, std::string\u003e headers_; // Request headers.\\n    std::unordered_map\u003cstd::string, std::string\u003e post_params_; // POST parameters.\\n};\\n\\n}\\n\\n#endif\",\n      \"file_id\": \"F03\",\n      \"unit_id\": \"U03\"\n    },\n    {\n      \"content\": \"// Implementation for Request class and its parsing logic.\\n// This file is intentionally left blank as per the instructions.\\n\\n#include \\\"request.h\\\"\\n\\nRequest::void Parse(Buffer\u0026 buf) throw(std::invalid_argument) {\\n  Parse(buf);\\n}\\n\\nstd::optional\u003cstd::string_view\u003e Request::Header(std::string_view key) const noexcept {\\n    return Header(key);\\n}\\n\\nstd::optional\u003cstd::string_view\u003e Request::Post(std::string_view key) const noexcept {\\n  return Post(key);\\n}\\n\\nsize_t Request::PostSize() const noexcept {\\n  return PostSize();\\n}\\n\\nstd::string Request::Method() const noexcept {\\n    return Method();\\n}\\n\\nstd::string Request::Path() const noexcept {\\n    return Path();\\n}\\n\\nstd::string Request::Version() const noexcept {\\n  return Version();\\n}\\n\\nbool Request::KeepAlive() const noexcept {\\n  return KeepAlive();\\n}\",\n      \"file_id\": \"F04\",\n      \"unit_id\": \"U04\"\n    },\n    {\n      \"content\": \"#ifndef WS_HTTP_RESPONSE_H\\n#define WS_HTTP_RESPONSE_H\\n\\n#include \u003cstring\u003e\\n#include \u003cfilesystem\u003e\\n#include \u003cbuffer\u003e\\n#include \u003coptional\u003e\\n#include \u003cunordered_map\u003e\\n\\nnamespace ws::http {\\n\\nclass Response {\\npublic:\\n    void Build(Buffer\u0026 buf, std::filesystem::path file, StatusCode\u0026 code);\\n    void Build(Buffer\u0026 buf, std::filesystem::path html, const Parameters\u0026 params, StatusCode\u0026 code);\\n    void Build(Buffer\u0026 buf, StatusCode code, std::string msg);\\n    void SetKeepAlive(bool set);\\n};\\n\\n}\\n\\n#endif\",\n      \"file_id\": \"F05\",\n      \"unit_id\": \"U05\"\n    },\n    {\n      \"content\": \"// Implementation for Response class and its building logic.\\n// This file is intentionally left blank 