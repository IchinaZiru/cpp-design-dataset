OWN\\\";\\n    }\\n}\\n\\nMethod StringToMethod(std::string str) {\\n    if (str == \\\"GET\\\") return Method::Get;\\n    if (str == \\\"POST\\\") return Method::Post;\\n    if (str == \\\"PUT\\\") return Method::Put;\\n    if (str == \\\"PATCH\\\") return Method::Patch;\\n    if (str == \\\"DELETE\\\") return Method::Delete;\\n    throw std::invalid_argument(\\\"Invalid HTTP method: \\\" + str);\\n}\\n\\nstd::string ContentTypeByFileName(std::string_view name) {\\n    static const std::unordered_map\u003cstd::string, std::string\u003e content_types = {\\n        {\\\".html\\\", \\\"text/html\\\"},\\n        {\\\".css\\\", \\\"text/css\\\"},\\n        {\\\".js\\\", \\\"application/javascript\\\"},\\n        {\\\".png\\\", \\\"image/png\\\"},\\n        {\\\".jpg\\\", \\\"image/jpeg\\\"},\\n        {\\\".gif\\\", \\\"image/gif\\\"}\\n    };\\n\\n    size_t dot_pos = name.rfind('.');\\n    if (dot_pos != std::string_view::npos) {\\n        auto it = content_types.find(name.substr(dot_pos));\\n        if (it != content_types.end()) {\\n            return it-\u003esecond;\\n        }\\n    }\\n    return \\\"application/octet-stream\\\";\\n}\\n\\nstd::string DecodeURLEncodedCharacter(const std::string\u0026 str) {\\n    if (str.length() == 3 \u0026\u0026 str[0] == '%') {\\n        try {\\n            size_t pos = 0;\\n            unsigned int hex_value = std::stoul(str.substr(1, 2), \u0026pos, 16);\\n            return std::string(1, static_cast\u003cchar\u003e(hex_value));\\n        } catch (const std::invalid_argument\u0026 e) {\\n            throw std::invalid_argument(\\\"Invalid URL-encoded character: \\\" + str);\\n        }\\n    } else if (str == \\\"+\\\"){\\n      return \\\"\\\";\\n    }else {\\n        throw std::invalid_argument(\\\"Invalid URL-encoded string format.\\\");\\n    }\\n}\\n\\nstd::string DecodeURLEncodedString(const std::string\u0026 str) {\\n    std::string decoded_str;\\n    for (size_t i = 0; i \u003c str.length(); ++i) {\\n        if (str[i] == '%') {\\n            decoded_str += DecodeURLEncodedCharacter(str.substr(i, 3));\\n            i += 2;\\n        } else if (str[i] == '+'){ \\n          // '+' is decoded as space.\\n        }else{\\n            decoded_str += str[i];\\n        }\\n    }\\n    return decoded_str;\\n}\\n\\nstd::string HTMLPlaceholder(std::string_view key) {\\n    return \\\"\u003c\\\" + std::string(key) + \\\"\u003e\\\";\\n}\\n\\nstd::string PutParamIntoHTML(std::string html, const Parameters\u0026 params) {\\n    for (const auto\u0026 pair : params) {\\n        size_t pos = 0;\\n        std::string key = pair.first;\\n        while ((pos = html.find(\\\"\u003c\\\" + key + \\\"\\\", pos)) != std::string::npos) {\\n            html.replace(pos, key.length() + 2, pair.second);\\n            pos += pair.second.length();\\n        }\\n    }\\n    return html;\\n}\\n\\n}\\n}\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    },\n    {\n      \"content\": \"// Placeholder for containers/buffer.h - Not implementing\\n// Assuming the existence of ws::Buffer and ws::IOBuffer classes.\\nnamespace ws {\\nclass Buffer {\\npublic:\\n  Buffer() : size_(1000) {}\\nprivate:\\n int size_;\\n};\\n\\nclass IOBuffer : public Buffer{\\npublic:\\n  IOBuffer(){}\\n};\\n}\\n\",\n      \"file_id\": \"F03\",\n      \"unit_id\": \"U03\"\n    },\n    {\n      \"content\": \"// Placeholder for ip.h - Not implementing\\n// Assuming the existence of ws::IPAddr, ws::IPv4Addr, and ws::IPv6Addr classes.\\nnamespace ws {\\nclass IPAddr {};\\nclass IPv4Addr : public IPAddr{};\\nclass IPv6Addr : public IPAddr{};\\n}\\n\",\n      \"file_id\": \"F04\",\n      \"unit_id\": \"U04\"\n    },\n    {\n      \"content\": \"// Placeholder for util.h - Not implementing\\n// Assuming the existence of std::filesystem::path and ws::FileDescriptor.\\n#include \u003cfilesystem\u003e\\nnamespace ws {\\nclass FileDescriptor {};\\n}\\n\",\n      \"file_id\": \"F05\",\n      \"unit_id\": \"U05\"\n    },\n    {\n      \"