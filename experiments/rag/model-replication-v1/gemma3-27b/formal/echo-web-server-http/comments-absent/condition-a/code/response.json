{"model":"gemma3:27b","created_at":"2026-08-11T10:35:33.4031944Z","response":"{\n  \"units\": [\n    {\n      \"content\": \"#ifndef WS_HTTP_H\\n#define WS_HTTP_H\\n\\n#include \u003ccstdint\u003e\\n#include \u003cstring\u003e\\n#include \u003cstring_view\u003e\\n#include \u003cunordered_map\u003e\\n#include \u003cfilesystem\u003e\\n#include \u003coptional\u003e\\n\\nnamespace ws::http {\\n\\n// Forward declarations (assuming these are defined elsewhere)\\nclass MappedReadOnlyFile;\\n\\nenum class StatusCode : std::uint32_t {\\n    OK = 200,\\n    BadRequest = 400,\\n    NotFound = 404,\\n    InternalServerError = 500\\n};\\n\\nenum class Method {\\n    GET,\\n    POST,\\n    PUT,\\n    DELETE,\\n    PATCH\\n};\\n\\ntypedef std::unordered_map\u003cstd::string, std::string\u003e Parameters;\\n\\nconstexpr std::string_view version = \\\"1.1\\\";\\nconstexpr std::string_view new_line = \\\"\\\\r\\\\n\\\";\\n\\nStatusCode ContentTypeByFileName(std::string_view name);\\nstd::string StatusCodeToMessage(StatusCode code);\\nstd::uint32_t StatusCodeToInteger(StatusCode code);\\nstd::string MethodToString(Method method);\\nMethod StringToMethod(std::string str);\\nstd::string DecodeURLEncodedCharacter(const std::string\u0026 str);\\nstd::string DecodeURLEncodedString(const std::string\u0026 str);\\nstd::string HTMLPlaceholder(std::string_view key);\\nstd::string PutParamIntoHTML(std::string html, const Parameters\u0026 params);\\n\\n}\\n\\n#endif // WS_HTTP_H\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    },\n    {\n      \"content\": \"#include \u003ciostream\u003e\\n#include \u003cfstream\u003e\\n#include \u003csstream\u003e\\n#include \u003calgorithm\u003e\\n\\nnamespace ws::http {\\n\\nStatusCode ContentTypeByFileName(std::string_view name) {\\n    if (name.ends_with(\\\".html\\\") || name.ends_with(\\\".htm\\\")) {\\n        return StatusCode::OK;\\n    } else if (name.ends_with(\\\".txt\\\")) {\\n        return StatusCode::OK;\\n    } else if (name.ends_with(\\\".jpg\\\") || name.ends_with(\\\".jpeg\\\")) {\\n        return StatusCode::OK;\\n    } else if (name.ends_with(\\\".png\\\")) {\\n        return StatusCode::OK;\\n    } else {\\n        return StatusCode::NotFound;\\n    }\\n}\\n\\nstd::string StatusCodeToMessage(StatusCode code) {\\n    switch (code) {\\n        case StatusCode::OK: return \\\"OK\\\";\\n        case StatusCode::BadRequest: return \\\"Bad Request\\\";\\n        case StatusCode::NotFound: return \\\"Not Found\\\";\\n        case StatusCode::InternalServerError: return \\\"Internal Server Error\\\";\\n        default: return \\\"Unknown Status Code\\\";\\n    }\\n}\\n\\nstd::uint32_t StatusCodeToInteger(StatusCode code) {\\n    return static_cast\u003cstd::uint32_t\u003e(code);\\n}\\n\\nstd::string MethodToString(Method method) {\\n    switch (method) {\\n        case Method::GET: return \\\"GET\\\";\\n        case Method::POST: return \\\"POST\\\";\\n        case Method::PUT: return \\\"PUT\\\";\\n        case Method::DELETE: return \\\"DELETE\\\";\\n        case Method::PATCH: return \\\"PATCH\\\";\\n        default: return \\\"UNKNOWN\\\";\\n    }\\n}\\n\\nMethod StringToMethod(std::string str) {\\n    if (str == \\\"GET\\\") return Method::GET;\\n    if (str == \\\"POST\\\") return Method::POST;\\n    if (str == \\\"PUT\\\") return Method::PUT;\\n    if (str == \\\"DELETE\\\") return Method::DELETE;\\n    if (str == \\\"PATCH\\\") return Method::PATCH;\\n    return Method::GET; // Default to GET\\n}\\n\\nstd::string DecodeURLEncodedCharacter(const std::string\u0026 str) {\\n    std::stringstream decoded_char;\\n    for (char c : str) {\\n        if (c == '%') {\\n            // Assuming hexadecimal encoding\\n            std::string hex_value = str.substr(1, 2);\\n            try {\\n                int char_code = std::stoi(hex_value, nullptr, 16);\\n                decoded_char \u003c\u003c static_cast\u003cchar\u003e(char_code);\\n            } catch (const std::invalid_argument\u0026 e) {\\n                // Handle invalid hex value\\n                return \\\"\\\"; // Or some error indicator\\n            }\\n        } else if (c == '+') {\\n            decoded_char \u003c\u003c ' ';\\n        } else {\\n            decoded_char \u003c\u003c c;\\n        }\\n    }\\n    return decoded_char.str();\\n}\\n\\nstd::string DecodeURLEncodedString(const std::string\u0026 str) {\\n    std::string decoded_string;\\n    size_t pos = 0;\\n    while (pos \u003c str.length()) {\\n        if (str[pos] == '%') {\\n            decoded_string += DecodeURLEncodedCharacter(str.substr(pos, 3));\\n            pos += 3;\\n        } else if (str[pos] == '+') {\\n            decoded_string += ' ';\\n            pos++;\\n        } else {\\n            decoded_string += str[pos];\\n            pos++;\\n        }\\n    }\\n    return decoded_string;\\n}\\n\\nstd::string HTMLPlaceholder(std::string_view key) {\\n    return \\\"\u003c$\\\" + std::string(key) + \\\"\u003e\\\";\\n}\\n\\nstd::string PutParamIntoHTML(std::string html, const Parameters\u0026 params) {\\n    for (const auto\u0026 [key, value] : params) {\\n        size_t pos = 0;\\n        while ((pos = html.find(HTMLPlaceholder(key), pos)) != std::string::npos) {\\n            html.replace(pos, HTMLPlaceholder(key).length(), value);\\n            pos += value.length();\\n        }\\n    }\\n    return html;\\n}\\n\\n}\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    },\n    {\n      \"content\": \"#ifndef WS_HTTP_REQUEST_H\\n#define WS_HTTP_REQUEST_H\\n\\n#include \u003cstring\u003e\\n#include \u003cstring_view\u003e\\n#include \u003cunordered_map\u003e\\n#include \u003coptional\u003e\\n\\nnamespace ws::http {\\n\\nenum class StatusCode : std::uint32_t;\\nenum class Method;\\ntypedef std::unordered_map\u003cstd::string, std::string\u003e Parameters;\\n\\nclass Request {\\npublic:\\n    Request();\\n    void Parse(Buffer\u0026 buf);\\n    std::optional\u003cstd::string\u003e Header(std::string_view key);\\n    std::optional\u003cstd::string\u003e Post(std::string_view key);\\n    Method Method();\\n    std::string Path();\\n    std::string Version();\\n\\nprivate:\\n    class State {\\n    public:\\n        virtual ~State() = default;\\n        virtual void Process(Request\u0026 req, Buffer\u0026 buf) = 0;\\n    };\\n\\n    State* state_; // Pointer to the current parsing state\\n    Method method_;\\n    std::string version_;\\n    std::string path_;\\n    Parameters headers_;  // Request Headers\\n    Parameters post_;     // POST parameters\\n};\\n\\n}\\n\\n#endif // WS_HTTP_REQUEST_H\",\n      \"file_id\": \"F03\",\n      \"unit_id\": \"U03\"\n    },\n    {\n      \"content\": \"#include \\\"request.h\\\"\\n#include \u003ciostream\u003e\\n// Assuming Buffer class is defined in containers/buffer.h\\nclass Buffer;\\nnamespace ws::http {\\n\\nRequest::Request() : state_(nullptr) {}\\n\\nvoid Request::Parse(Buffer\u0026 buf) {\\n    // Placeholder for parsing logic - State machine implementation would go here.\\n    // This is a simplified example and doesn't implement the full state machine.\\n    std::string line;\\n    if (buf.ReadLine(line)) {\\n        size_t pos = line.find(\\\" \\\");\\n        if (pos != std::string::npos) {\\n            std::string method_str = line.substr(0, pos);\\n            method_ = StringToMethod(method_str);\\n            path_ = line.substr(pos + 1);\\n        }\\n    }\\n\\n    // Read headers (simplified)\\n    while (true) {\\n        std::string header_line;\\n        if (!buf.ReadLine(header_line)) break;\\n        size_t pos = header_line.find(\\\": \\\");\\n        if (pos != std::string::npos) {\\n            std::string key = header_line.substr(0, pos);\\n            std::string value = header_line.substr(pos + 2);\\n            headers_[key] = value;\\n        }\\n    }\\n\\n    // Read body (simplified)\\n    // In a real implementation, you'd need to handle content length and chunked encoding.\\n}\\n\\nstd::optional\u003cstd::string\u003e Request::Header(std::string_view key) {\\n    auto it = headers_.find(key);\\n    if (it != headers_.end()) {\\n        return it-\u003esecond;\\n    } else {\\n        return std::nullopt;\\n    }\\n}\\n\\nstd::optional\u003cstd::string\u003e Request::Post(std::string_view key) {\\n    auto it = post_.find(key);\\n    if (it != post_.end()) {\\n        return it-\u003esecond;\\n    } else {\\n        return std::nullopt;\\n    }\\n}\\n\\nMethod Request::Method() { return method_; }\\nstd::string Request::Path() { return path_; }\\nstd::string Request::Version() { return version_; }\\n\\n}\\n\",\n      \"file_id\": \"F04\",\n      \"unit_id\": \"U04\"\n    },\n    {\n      \"content\": \"#ifndef WS_HTTP_RESPONSE_H\\n#define WS_HTTP_RESPONSE_H\\n\\n#include \u003cstring\u003e\\n#include \u003cfilesystem\u003e\\n#include \u003cunordered_map\u003e\\n#include \u003coptional\u003e\\n\\nnamespace ws::http {\\n\\nenum class StatusCode : std::uint32_t;\\ntypedef std::unordered_map\u003cstd::string, std::string\u003e Parameters;\\n\\nclass MappedReadOnlyFile;\\n\\nclass Response {\\npublic:\\n    Response(const std::filesystem::path\u0026 root_dir);\\n    void Build(Buffer\u0026 buf, std::filesystem::path file, StatusCode\u0026 code);\\n    void Build(Buffer\u0026 buf, std::filesystem::path html, const Parameters\u0026 params, StatusCode\u0026 code);\\n    void Build(Buffer\u0026 buf, StatusCode code, std::string msg);\\n\\nprivate:\\n    const std::filesystem::path root_dir_; // Root directory for serving files\\n    std::filesystem::path file_path_;       // Path to the file being served (if any)\\n    MappedReadOnlyFile* file_;              // Mapped readonly file object\\n    bool keep_alive_;                       // Keep-alive flag\\n    StatusCode status_code_;\\n};\\n\\n}\\n\\n#endif // WS_HTTP_RESPONSE_H\",\n      \"file_id\": \"F05\",\n      \"unit_id\": \"U05\"\n    },\n    {\n      \"content\": \"#include \\\"response.h\\\"\\n#include \u003ciostream\u003e\\n// Assuming Buffer and MappedReadOnlyFile are defined elsewhere\\nclass Buffer;\\nclass MappedReadOnlyFile;\\nnamespace ws::http {\\n\\nResponse::Response(const std::filesystem::path\u0026 root_dir) : root_dir_(root_dir), file_(nullptr), keep_alive_(false), status_code_(StatusCode::OK) {}\\n\\nvoid Response::Build(Buffer\u0026 buf, std::filesystem::path file, StatusCode\u0026 code) {\\n    file_path_ = file;\\n    try {\\n        file_ = new MappedReadOnlyFile(file_path_); // Assuming constructor takes path\\n        code = StatusCode::OK; \\n    } catch (const std::exception\u0026 e) {\\n        std::cerr \u003c\u003c \\\"Error opening file: \\\" \u003c\u003c e.what() \u003c\u003c std::endl;\\n        code = StatusCode::NotFound;\\n        return;\\n    }\\n\\n    // Send the file content to the buffer\\n    if(file_ != nullptr){\\n      buf.Write(file_-\u003eData(), file_-\u003eSize());\\n    }\\n\\n    delete file_; // Clean up after writing.\\n}\\n\\nvoid Response::Build(Buffer\u0026 buf, std::filesystem::path html, const Parameters\u0026 params, StatusCode\u0026 code) {\\n    // Load the HTML template from the file\\n    std::ifstream file(html);\\n    if (!file.is_open()) {\\n        code = StatusCode::NotFound;\\n        return;\\n    }\\n    std::string html_content((std::istreambuf_iterator\u003cchar\u003e(file)), std::istreambuf_iterator\u003cchar\u003e());\\n    file.close();\\n\\n    // Replace placeholders with parameters\\n    std::string modified_html = PutParamIntoHTML(html_content, params);\\n\\n    // Write the modified HTML to the buffer\\n    buf.WriteString(modified_html);\\n    code = StatusCode::OK;\\n}\\n\\nvoid Response::Build(Buffer\u0026 buf, StatusCode code, std::string msg) {\\n    // Build an error response with the given status code and message.\\n    std::string response_str = \\\"HTTP/1.1 \\\" + std::to_string(StatusCodeToInteger(code)) + \\\" \\\" + StatusCodeToMessage(code) + new_line;\\n    response_str += \\\"Content-Type: text/plain\\\" + new_line;\\n    response_str += new_line;\\n    response_str += msg + new_line;\\n\\n    buf.WriteString(response_str);\\n}\\n\\n}\",\n      \"file_id\": \"F06\",\n      \"unit_id\": \"U06\"\n    }\n  ]\n}","done":true,"done_reason":"stop","context":[105,2430,107,229197,236780,2124,51355,237921,25352,64764,237457,3652,236924,237658,237495,38152,61514,34611,55635,238211,14606,237051,34855,23086,238219,241817,12547,236951,237748,239106,44675,51355,237051,240854,129445,25352,49391,236924,174705,237977,237748,239106,6805,236945,240174,237441,237051,34611,55635,238211,5077,117954,237010,236951,9266,240174,237441,97997,4042,83306,14606,237051,81554,49391,236924,2501,237748,239106,6805,9450,236951,240754,237122,239088,237731,236951,68343,237518,236951,23595,237050,237983,237311,2234,236951,238189,240199,237313,236951,237857,240121,238663,238921,242771,236951,68343,3063,85678,23595,237050,68343,67189,237051,25352,237010,236951,3063,57544,237364,14606,87580,237473,3335,45621,237406,13772,236924,10602,236772,2164,46179,7498,236772,2164,237748,239106,6805,9450,236951,3917,9200,46179,36641,236951,80395,3917,236951,10699,236951,3091,236951,237731,164683,236951,95522,71924,236951,95522,9892,167023,236951,239050,238460,85678,23595,237050,195214,25352,49391,236924,21695,23086,68343,111166,236951,164683,14606,236951,46179,40844,37899,13850,14606,87580,237473,3335,45621,237406,13772,236924,10602,236772,2164,236786,7498,236772,2164,9450,3917,237512,10699,237156,237748,239106,6805,76443,30786,70381,238446,237505,236951,2501,236786,12247,236772,1688,74168,120531,51355,238081,237557,83306,237051,81554,3335,45621,237406,13772,236924,34611,55635,238211,237000,71666,17011,237731,236951,23991,237522,236951,226942,239869,238394,236951,24292,239869,238394,236951,33264,239088,236951,1899,2479,236951,69564,23991,237051,111166,237156,183672,237322,239309,238914,237474,237322,237520,238927,238395,237881,3335,45621,237406,13772,236924,61747,49482,46179,189820,