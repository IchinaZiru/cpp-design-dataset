{"model":"qwen2.5-coder:32b","created_at":"2026-08-10T17:06:51.7512969Z","response":"{\n  \"units\": [\n    {\n      \"content\": \"void Request::Parse(Buffer\u0026 buf) {\\n    if (buf.ReadableSize() == 0) {\\n        throw std::invalid_argument(\\\"Buffer is empty\\\");\\n    }\\n\\n    // Parse status line\\n    std::string_view status_line = buf.ReadLine();\\n    size_t method_end = status_line.find(' ');\\n    if (method_end == std::string_view::npos) {\\n        throw std::invalid_argument(\\\"Invalid status line format\\\");\\n    }\\n    method_ = http::MethodFromString(status_line.substr(0, method_end));\\n\\n    size_t path_start = method_end + 1;\\n    size_t path_end = status_line.find(' ', path_start);\\n    if (path_end == std::string_view::npos) {\\n        throw std::invalid_argument(\\\"Invalid status line format\\\");\\n    }\\n    path_ = status_line.substr(path_start, path_end - path_start);\\n\\n    size_t version_start = path_end + 1;\\n    version_ = status_line.substr(version_start);\\n\\n    // Parse headers\\n    while (true) {\\n        std::string_view header_line = buf.ReadLine();\\n        if (header_line.empty()) {\\n            break;\\n        }\\n        size_t colon_pos = header_line.find(':');\\n        if (colon_pos == std::string_view::npos) {\\n            throw std::invalid_argument(\\\"Invalid header format\\\");\\n        }\\n        std::string key(header_line.substr(0, colon_pos));\\n        std::string value(header_line.substr(colon_pos + 1));\\n        headers_.emplace(std::move(key), std::move(value));\\n    }\\n\\n    // Parse body (POST data)\\n    if (method_ == http::Method::Post) {\\n        size_t content_length = 0;\\n        auto it = headers_.find(\\\"Content-Length\\\");\\n        if (it != headers_.end()) {\\n            content_length = std::stoi(it-\u003esecond);\\n        }\\n        post_.Parse(buf.Read(content_length));\\n    }\\n}\",\n      \"file_id\": \"F01\",\n      \"unit_id\": \"U01\"\n    },\n    {\n      \"content\": \"std::optional\u003cMappedReadOnlyFile\u003e Response::Build(Buffer\u0026 buf, std::filesystem::path file, StatusCode\u0026 code) noexcept {\\n    file_path_ = root_dir_ / file;\\n    if (!std::filesystem::exists(file_path_)) {\\n        status_code_ = StatusCode::NotFound;\\n        AddPredefinedErrorContent(buf);\\n        return std::nullopt;\\n    }\\n\\n    file_.Map(file_path_);\\n    if (!file_.IsValid()) {\\n        status_code_ = StatusCode::InternalServerError;\\n        AddPredefinedErrorContent(buf);\\n        return std::nullopt;\\n    }\\n\\n    status_code_ = code;\\n    AddStatusLine(buf);\\n    AddHeaders(buf);\\n    AddMappedContent(buf);\\n    return file_;\\n}\",\n      \"file_id\": \"F02\",\n      \"unit_id\": \"U02\"\n    },\n    {\n      \"content\": \"#include \u003cfilesystem\u003e\\n#include \u003cstring_view\u003e\\n#include \u003coptional\u003e\\n#include \u003cstring\u003e\\n#include \u003ccstdint\u003e\\n\\nnamespace http {\\nenum class Method { Get, Post };\\nMethod MethodFromString(std::string_view str);\\n}\\n\\nclass Buffer {\\npublic:\\n    size_t ReadableSize() const noexcept;\\n    std::string_view ReadLine();\\n    std::string_view Read(size_t n);\\n};\\n\\nclass FileDescriptor {\\n};\\n\\nconstexpr FileDescriptor invalid_file_descriptor{};\\n\\nclass IOBuffer {\\npublic:\\n    size_t ReadableSize() const noexcept;\\n};\\n\\nclass MappedReadOnlyFile {\\npublic:\\n    void Map(const std::filesystem::path\u0026 path);\\n    bool IsValid() const noexcept;\\n};\\n\\nenum class StatusCode { OK, NotFound, InternalServerError };\\n\\ntemplate \u003ctypename T\u003e\\nclass Parameters {\\npublic:\\n    void Parse(std::string_view data);\\n    std::optional\u003cT\u003e Get(const std::string\u0026 key) const noexcept;\\n};\\n\",\n      \"file_id\": \"F03\",\n      \"unit_id\": \"U03\"\n    },\n    {\n      \"content\": \"#include \\\"connection_impl.h\\\"\\n#include \u003cfilesystem\u003e\\n\\nstd::filesystem::path ConnectionImpl::root_dir_;\\n\\nvoid ConnectionImpl::SetRootDirectory(std::filesystem::path dir) noexcept {\\n    root_dir_ = std::move(dir);\\n}\\n\\nstd::filesystem::path ConnectionImpl::GetRootDirectory() noexcept {\\n    return root_dir_;\\n}\\n\\nvoid ConnectionImpl::Close() noexcept {\\n    // Close the connection\\n}\\n\\nbool ConnectionImpl::Valid() const noexcept {\\n    return socket_ != invalid_file_descriptor;\\n}\\n\\nFileDescriptor ConnectionImpl::Socket() const noexcept {\\n    return socket_;\\n}\\n\\nstd::size_t ConnectionImpl::Receive() {\\n    // Receive data into read_buf_\\n    return 0; // Placeholder return value\\n}\\n\\nstd::size_t ConnectionImpl::Send() {\\n    // Send data from write_buf_\\n    return 0; // Placeholder return value\\n}\\n\\nbool ConnectionImpl::KeepAlive() const noexcept {\\n    return keep_alive_;\\n}\\n\\nbool ConnectionImpl::Process() noexcept {\\n    if (read_buf_.ReadableSize() == 0) {\\n        keep_alive_ = false;\\n        return false;\\n    }\\n\\n    Request request(read_buf_);\\n    request.Parse(read_buf_);\\n\\n    Response response(root_dir_);\\n    StatusCode status_code = StatusCode::OK;\\n    auto file_opt = response.Build(write_buf_, std::filesystem::path(request.Path()), status_code);\\n\\n    if (file_opt) {\\n        file_ = *file_opt;\\n    } else {\\n        status_code = StatusCode::NotFound;\\n    }\\n\\n    keep_alive_ = request.KeepAlive();\\n    return true;\\n}\\n\",\n      \"file_id\": \"F04\",\n      \"unit_id\": \"U04\"\n    },\n    {\n      \"content\": \"#include \\\"request.h\\\"\\n#include \u003cstdexcept\u003e\\n#include \u003cstring_view\u003e\\n\\nRequest::Request() noexcept = default;\\n\\nRequest::Request(Buffer\u0026 buf) {\\n    Parse(buf);\\n}\\n\\nRequest::~Request() noexcept = default;\\n\\nvoid Request::Parse(Buffer\u0026 buf) {\\n    if (buf.ReadableSize() == 0) {\\n        throw std::invalid_argument(\\\"Buffer is empty\\\");\\n    }\\n\\n    // Parse status line\\n    std::string_view status_line = buf.ReadLine();\\n    size_t method_end = status_line.find(' ');\\n    if (method_end == std::string_view::npos) {\\n        throw std::invalid_argument(\\\"Invalid status line format\\\");\\n    }\\n    method_ = http::MethodFromString(status_line.substr(0, method_end));\\n\\n    size_t path_start = method_end + 1;\\n    size_t path_end = status_line.find(' ', path_start);\\n    if (path_end == std::string_view::npos) {\\n        throw std::invalid_argument(\\\"Invalid status line format\\\");\\n    }\\n    path_ = status_line.substr(path_start, path_end - path_start);\\n\\n    size_t version_start = path_end + 1;\\n    version_ = status_line.substr(version_start);\\n\\n    // Parse headers\\n    while (true) {\\n        std::string_view header_line = buf.ReadLine();\\n        if (header_line.empty()) {\\n            break;\\n        }\\n        size_t colon_pos = header_line.find(':');\\n        if (colon_pos == std::string_view::npos) {\\n            throw std::invalid_argument(\\\"Invalid header format\\\");\\n        }\\n        std::string key(header_line.substr(0, colon_pos));\\n        std::string value(header_line.substr(colon_pos + 1));\\n        headers_.emplace(std::move(key), std::move(value));\\n    }\\n\\n    // Parse body (POST data)\\n    if (method_ == http::Method::Post) {\\n        size_t content_length = 0;\\n        auto it = headers_.find(\\\"Content-Length\\\");\\n        if (it != headers_.end()) {\\n            content_length = std::stoi(it-\u003esecond);\\n        }\\n        post_.Parse(buf.Read(content_length));\\n    }\\n}\\n\\nstd::optional\u003cstd::string_view\u003e Request::Header(std::string_view key) const noexcept {\\n    auto it = headers_.find(key);\\n    if (it != headers_.end()) {\\n        return it-\u003esecond;\\n    }\\n    return std::nullopt;\\n}\\n\\nstd::optional\u003cstd::string_view\u003e Request::Post(std::string_view key) const noexcept {\\n    auto it = post_.Get(key);\\n    if (it) {\\n        return *it;\\n    }\\n    return std::nullopt;\\n}\\n\\nstd::size_t Request::PostSize() const noexcept {\\n    return post_.ReadableSize();\\n}\\n\\nhttp::Method Request::Method() const noexcept {\\n    return method_;\\n}\\n\\nstd::string_view Request::Path() const noexcept {\\n    return path_;\\n}\\n\\nstd::string_view Request::Version() const noexcept {\\n    return version_;\\n}\\n\\nbool Request::KeepAlive() const noexcept {\\n    auto it = headers_.find(\\\"Connection\\\");\\n    if (it != headers_.end() \u0026\u0026 it-\u003esecond == \\\"keep-alive\\\") {\\n        return true;\\n    }\\n    return false;\\n}\\n\",\n      \"file_id\": \"F05\",\n      \"unit_id\": \"U05\"\n    },\n    {\n      \"content\": \"#include \\\"response.h\\\"\\n#include \u003cfilesystem\u003e\\n\\nResponse::Response(std::filesystem::path root_dir) noexcept : root_dir_(std::move(root_dir)) {}\\n\\nResponse::~Response() noexcept = default;\\n\\nResponse\u0026 Response::SetKeepAlive(bool set) noexcept {\\n    keep_alive_ = set;\\n    return *this;\\n}\\n\\nstd::optional\u003cMappedReadOnlyFile\u003e Response::Build(Buffer\u0026 buf, std::filesystem::path file, StatusCode\u0026 code) noexcept {\\n    file_path_ = root_dir_ / file;\\n    if (!std::filesystem::exists(file_path_)) {\\n        status_code_ = StatusCode::NotFound;\\n        AddPredefinedErrorContent(buf);\\n        return std::nullopt;\\n    }\\n\\n    file_.Map(file_path_);\\n    if (!file_.IsValid()) {\\n        status_code_ = StatusCode::InternalServerError;\\n        AddPredefinedErrorContent(buf);\\n        return std::nullopt;\\n    }\\n\\n    status_code_ = code;\\n    AddStatusLine(buf);\\n    AddHeaders(buf);\\n    AddMappedContent(buf);\\n    return file_;\\n}\\n\\nvoid Response::Build(Buffer\u0026 buf, std::filesystem::path html, const Parameters\u003cstd::string\u003e\u0026 params, StatusCode\u0026 code) noexcept {\\n    file_path_ = root_dir_ / html;\\n    if (!std::filesystem::exists(file_path_)) {\\