(nodes_.empty()) {\\n            return Clock::duration{};\\n        }\\n        return nodes_.front().expiration - Clock::now();\\n    }\\n\\nprivate:\\n    struct Node {\\n        Key key;\\n        Clock::time_point expiration;\\n        TimeOutCallback callback;\\n\\n        bool Expired() const noexcept {\\n            return expiration \u003c= Clock::now();\\n        }\\n\\n        void Swap(Node\u0026 other) noexcept {\\n            std::swap(key, other.key);\\n            std::swap(expiration, other.expiration);\\n            std::swap(callback, other.callback);\\n        }\\n\\n        auto operator\u003c=\u003e(const Node\u0026) const = default;\\n    };\\n\\n    void Adjust(const Key\u0026 key, Clock::time_point expiration, std::optional\u003cTimeOutCallback\u003e callback) {\\n        if (auto it = key_to_idx_.find(key); it != key_to_idx_.end()) {\\n            auto idx = it-\u003esecond;\\n            nodes_[idx].expiration = expiration;\\n            if (callback) {\\n                nodes_[idx].callback = *std::move(callback);\\n            }\\n            ShiftUp(idx);\\n            ShiftDown(idx);\\n        } else {\\n            throw std::out_of_range(\\\"Key not found in timer system\\\");\\n        }\\n    }\\n\\n    Key RemoveByIndex(std::size_t idx) noexcept {\\n        Swap(idx, nodes_.size() - 1);\\n        auto key = nodes_.back().key;\\n        key_to_idx_.erase(key);\\n        nodes_.pop_back();\\n        if (idx \u003c nodes_.size()) {\\n            ShiftUp(idx);\\n            ShiftDown(idx);\\n        }\\n        return key;\\n    }\\n\\n    void ShiftUp(std::size_t idx) noexcept {\\n        while (auto parent_idx = Parent(idx); parent_idx \u0026\u0026 nodes_[*parent_idx] \u003e nodes_[idx]) {\\n            Swap(*parent_idx, idx);\\n            idx = *parent_idx;\\n        }\\n    }\\n\\n    void ShiftDown(std::size_t idx) noexcept {\\n        while (auto child_idx = SmallChild(idx); child_idx \u0026\u0026 nodes_[*child_idx] \u003c node