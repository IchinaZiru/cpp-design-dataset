  "response": "{\n  \"files\": [\n    {\n      \"path\": \"include/containers/thread_pool.h\",\n      \"content\": \"/**\\n * @file thread_pool.h\\n * @brief The thread pool.\\n *\\n * @author Zhenshuo Chen (chenzs108@outlook.com)\\n * @author Liu Guowen (liu.guowen@outlook.com)\\n * @par GitHub\\n * https://github.com/Zhuagenborn\\n * @version 1.0\\n * @date 2022-06-04\\n *\\n * @example tests/containers/thread_pool_test.cpp\\n */\\n\\n#pragma once\\n\\n#include \\\"log.h\\\"\\n\\n#include <condition_variable>\\n#include <functional>\\n#include <list>\\n#include <mutex>\\n#include <optional>\\n#include <thread>\\n\\n\\nnamespace ws {\\n\\n//! The thread pool.\\nclass ThreadPool {\\npublic:\\n    using Task = std::function<void() >;\\n\\n    /**\\n     * @brief Create a thread pool.\\n     *\\n     * @param thread_count\\n     * The number of working threads.\\n     * If it is @p std::nullopt or zero, the thread pool will use the number of concurrent threads supported by hardware.\\n     * @param logger\\n     * A logger. If it is @p nullptr, the thread pool will use the global root logger.\\n     */\\n    explicit ThreadPool(std::optional<std::size_t> thread_count = std::nullopt,\\n                        log::Logger::Ptr logger = log::RootLogger()) noexcept;\\n\\n    ~ThreadPool() noexcept;\\n\\n    ThreadPool(const ThreadPool&) = delete;\\n\\n    ThreadPool(ThreadPool&&) = delete;\\n\\n    ThreadPool& operator=(const ThreadPool&) = delete;\\n\\n    ThreadPool& operator=(ThreadPool&&) = delete;\\n\\n    //! Run the thread pool.\\n    void Start() noexcept;\\n\\n    //! Push a task into the thread pool.\\n    void Push(Task task) noexcept;\\n\\n    /**\\n     * @brief Close the thread pool.\\n     *\\n     * @details\\n     * The remaining tasks will not be executed.\\n     */\\n    void Close() noexcept;\\n\\nprivate:\\n    /**\\n     * @brief Continually pop and execute tasks.\\n     *\\n     * @warning\\n     * Any exceptions raised in callbacks will not be rethrown.\\n     * Exception messages will be recorded in the logger.\\n     */\\n    void ExecProc() noexcept;\\n\\n    log::Logger::Ptr logger_;\\n\\n    mutable std::mutex mtx_;\\n    std::atomic_bool closed_ {true};\\n    std::size_t thread_count_;\\n    std::condition_variable cond_;\\n\\n    std::list<Task> tasks_;\\n    std::list<std::thread> threads_;\\n};\\n\\n}  // namespace ws\\n\"\n    },\n    {\n      \"path\": \"src/containers/thread_pool/thread_pool.cpp\",\n      \"content\": \"#include \\\"thread_pool.h\\\"\\n#include \\\"util.h\\\"\\n#include <cassert>\\n\\nnamespace ws {\\n\\nThreadPool::ThreadPool(std::optional<std::size_t> thread_count, log::Logger::Ptr logger) noexcept\\n    : logger_(std::move(logger)),\\n      thread_count_(thread_count.value_or(std::thread::hardware_concurrency())) {}\\n\\nThreadPool::~ThreadPool() noexcept {\\n    Close();\\n    for (auto& thread : threads_) {\\n        if (thread.joinable()) {\\n            thread.join();\\n        }\\n    }\\n}\\n\\nvoid ThreadPool::Start() noexcept {\\n    assert(closed_);\\n    closed_.store(false);\\n    for (std::size_t i = 0; i < thread_count_; ++i) {\\n        threads_.emplace_back(&ThreadPool::ExecProc, this);\\n    }\\n}\\n\\nvoid ThreadPool::Push(Task task) noexcept {\\n    assert(!closed_);\\n    std::lock_guard lock(mtx_);\\n    tasks_.push_back(std::move(task));\\n    cond_.notify_one();\\n}\\n\\nvoid ThreadPool::Close() noexcept {\\n    {\\n        std::lock_guard lock(mtx_);\\n        closed_.store(true);\\n        cond_.notify_all();\\n    }\\n}\\n\\nvoid ThreadPool::ExecProc() noexcept {\\n    while (true) {\\n        Task task;\\n        {\\n            std::unique_lock lock(mtx_);\\n            cond_.wait(lock, [this] { return closed_ || !tasks_.empty(); });\\n            if (closed_ && tasks_.empty()) {\\n                break;\\n            }\\n            task = std::move(tasks_.front());\\n            tasks_.pop_front();\\n        }\\n        try {\\n            task();\\n        } catch (const std::exception& e) {\\n            logger_->Log(log::LogLevel::Error, \\\"Exception in thread pool task: {}\\\", e.what());\\n        } catch (...) {\\n            logger_->Log(log::LogLevel::Error, \\\"Unknown exception in thread pool task.\\\");\\n        }\\n    }\\n}\\n\\n}  // namespace ws\"\n    }\n  ]\n}",
