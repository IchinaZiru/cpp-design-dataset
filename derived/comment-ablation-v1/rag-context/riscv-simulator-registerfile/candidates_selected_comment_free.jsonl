{"content":"  \n                                     \n  \n\n#ifndef RISCV_SIMULATOR_REGISTER_HPP\n#define RISCV_SIMULATOR_REGISTER_HPP\n\ntemplate<typename T>\nclass Register {                       \npublic:\n    T prev, next;\n\n    bool _stall;\n\n    Register() : prev((T) 0), next((T) 0), _stall(false) {}\n\n    Register(T d) : prev(d), next(d), _stall(false) {}\n\n    T read() { return prev; }\n\n    T current() { return next; }\n\n    void write(const T &t) { next = t; }\n\n    void tick() { if (!_stall) prev = next; }\n\n    void stall(bool stall) { _stall = stall; }\n\n    operator T() { return read(); }\n\n    void operator=(T next) { write(next); }\n};\n\n#endif                               \n","content_bytes":668,"content_sha256":"9e58abeb53012d1002f06ba204951005929aed1a2eb6d00054a5ad6e0f2adaa5","include_spelling":"Register.hpp","normalization":"utf8-bom-aware-newlines-to-lf-v1","owner_paths":["src/Common/RegisterFile.hpp"],"path":"src/Common/Register.hpp","selection_reason":"direct_project_local_quoted_include_whole_file_one_hop","source_bytes":702,"source_sha256":"57fb42ae07816f444301153cdea5bf943b873262ff992e454b894ff990ad8e34","comment_ablation":{"source_formal_r2_content_sha256":"6890bd1d2e673be19ad1db79f647797da52c784d1963db9a43de0ce0ec33c7fb","line_comments_removed":5,"block_comments_removed":0,"total_comments_removed":5}}
