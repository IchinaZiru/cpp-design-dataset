{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "units": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "type": "string"
          },
          "file_id": {
            "pattern": "^F[0-9]{2}$",
            "type": "string"
          },
          "unit_id": {
            "pattern": "^U[0-9]{2}$",
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "unit_id",
          "content"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "units"
  ],
  "type": "object"
}
